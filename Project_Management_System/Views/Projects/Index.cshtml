            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Priority</label>
                    <select id="editPriority" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-amber-500 outline-none">
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                        <option value="Critical">Critical</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Status</label>
                    <select id="editStatus" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-amber-500 outline-none">
                        <option value="Planning">Planning</option>
                        <option value="Active">Active</option>
                        <option value="AtRisk">At Risk</option>
                        <option value="OnHold">On Hold</option>
                        <option value="Completed">Completed</option>
                        <option value="Archived">Archived</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Start Date</label>
                    <input type="date" id="editStartDate" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-amber-500 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Deadline</label>
                    <input type="date" id="editDeadline" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-amber-500 outline-none">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Budget ($)</label>
                    <input type="number" id="editBudget" min="0" step="1000" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-amber-500 outline-none">
                </div>
            </div>

            @if (canCreate)
            {
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Project Manager</label>
                    <select id="editPM" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-amber-500 outline-none">
                        <option value="">Unassigned</option>
                        @foreach (var pm in pms)
                        {
                            <option value="@pm.Id">@pm.FullName (@pm.Email)</option>
                        }
                    </select>
                </div>
            }

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1.5">Description</label>
                <textarea id="editDescription" rows="3" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-amber-500 outline-none resize-none"></textarea>
            </div>

            <div id="editProjectError" class="hidden p-3 bg-red-50 border border-red-200 rounded-lg">
                <p class="text-sm font-semibold text-red-700" id="editProjectErrorText"></p>
            </div>
        </form>

        <div class="bg-gray-50 px-6 py-4 flex justify-end gap-3 border-t">
            <button type="button" onclick="closeModal('editProjectModal')" class="px-5 py-2.5 border border-gray-300 rounded-lg font-semibold text-gray-700">Cancel</button>
            <button type="button" onclick="updateProject()" class="px-6 py-2.5 bg-amber-600 text-white rounded-lg font-bold hover:bg-amber-700">
                Save Changes
            </button>
        </div>
    </div>
</div>

