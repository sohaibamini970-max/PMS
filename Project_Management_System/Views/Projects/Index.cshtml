<div id="deleteProjectModal" style="display:none;" class="fixed inset-0 z-50 bg-gray-900/60 backdrop-blur-sm items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">
        <div class="bg-gradient-to-r from-red-500 to-rose-600 px-6 py-5 flex justify-between items-center">
            <h3 class="text-xl font-bold text-white">Delete Project</h3>
            <button onclick="closeModal('deleteProjectModal')" class="text-white/80 hover:text-white p-1 rounded-full hover:bg-white/20">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div class="p-6">
            <p class="text-base text-gray-700 mb-4">
                Delete <span class="font-bold text-gray-900" id="deleteProjectName">this project</span>?
                This action cannot be undone.
            </p>
            <div class="flex justify-end gap-3 pt-3 border-t">
                <button onclick="closeModal('deleteProjectModal')" class="px-5 py-2.5 border border-gray-300 rounded-lg font-semibold text-gray-700">Cancel</button>
                <button onclick="confirmDelete()" class="px-6 py-2.5 bg-red-600 text-white rounded-lg font-bold hover:bg-red-700">Delete Project</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let deletingId = null;

        function openModal(id) { const el = document.getElementById(id); if (el) el.style.display = 'flex'; }
        function closeModal(id) { const el = document.getElementById(id); if (el) el.style.display = 'none'; }

        function getToken() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        // ============ CREATE PROJECT ============
        function openAddModal() {
            ['addName','addClient','addDomain','addDescription','addStartDate','addDeadline','addBudget','addPM'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.value = '';
            });
            document.getElementById('addPriority').value = 'Medium';
            document.getElementById('addStatus').value = 'Planning';
            document.getElementById('addProjectError').classList.add('hidden');
            openModal('addProjectModal');
        }

        async function createProject() {
            const name = document.getElementById('addName').value.trim();
            const client = document.getElementById('addClient').value.trim();
            const domain = document.getElementById('addDomain').value;
            const priority = document.getElementById('addPriority').value;
            const status = document.getElementById('addStatus').value;
            const startDate = document.getElementById('addStartDate').value;
            const deadline = document.getElementById('addDeadline').value;
            const budget = document.getElementById('addBudget').value;
            const pmId = document.getElementById('addPM').value;
            const description = document.getElementById('addDescription').value.trim();

            const errEl = document.getElementById('addProjectError');
            const errText = document.getElementById('addProjectErrorText');

            if (!name) { errText.innerText = 'Project name is required.'; errEl.classList.remove('hidden'); return; }

            // if (!pmId) { errText.innerText = 'Please select a Project Manager.'; errEl.classList.remove('hidden'); return; }
            // errEl.classList.add('hidden');

            const btn = document.getElementById('btnCreateProject');
            const btnText = document.getElementById('btnCreateProjectText');
            btn.disabled = true;
            btnText.innerText = 'Creating...';

            try {
                const fd = new FormData();
                fd.append('Name', name);
                fd.append('Client', client);
                fd.append('Domain', domain);
                fd.append('Priority', priority);
                if (startDate) fd.append('StartDate', startDate);
                if (deadline) fd.append('Deadline', deadline);
                if (budget) fd.append('Budget', budget);
                fd.append('ProjectManagerId', pmId);
                fd.append('Description', description);
                fd.append('__RequestVerificationToken', getToken());

                const res = await fetch('/Projects/CreateProject', { method: 'POST', body: fd });
                const result = await res.json();

                if (result.success) {
                    closeModal('addProjectModal');
                    showToast(result.message, 'success');
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    errText.innerText = result.message || 'Failed to create project.';
                    errEl.classList.remove('hidden');
                }
            } catch (err) {
                errText.innerText = 'Network error. Please try again.';
                errEl.classList.remove('hidden');
            } finally {
                btn.disabled = false;
                btnText.innerText = 'Create Project';
            }
        }

                function toggleStatusMenu(event, menuId) {
            event.stopPropagation();
            document.querySelectorAll('[id^="statusMenu-"]').forEach(el => {
                if (el.id !== menuId) el.classList.add('hidden');
            });
            document.getElementById(menuId).classList.toggle('hidden');
        }
        document.addEventListener('click', function () {
            document.querySelectorAll('[id^="statusMenu-"]').forEach(el => el.classList.add('hidden'));
        });

        async function changeProjectStatus(event, projectId, status) {
            event.stopPropagation();
            event.preventDefault();

            const fd = new FormData();
            fd.append('id', projectId);
            fd.append('status', status);
            fd.append('__RequestVerificationToken', getToken());

            try {
                const res = await fetch('/Projects/UpdateStatus', { method: 'POST', body: fd });
                const result = await res.json();
                if (result.success) {
                    showToast(result.message, 'success');
                    setTimeout(() => location.reload(), 700);
                } else {
                    showToast(result.message, 'error');
                }
            } catch {
                showToast('Network error.', 'error');
            }
        }

        // ============ VIEW PROJECT ============
        async function openViewModal(id) {
            try {
                const res = await fetch(`/Projects/GetProject/${id}`);
                if (!res.ok) return;
                const p = await res.json();

                document.getElementById('viewTitle').innerText = p.name;
                document.getElementById('viewClient').innerText = p.client || '—';
                document.getElementById('viewDomain').innerText = p.domain || '—';
                document.getElementById('viewBudget').innerText = p.budget ? '$' + Number(p.budget).toLocaleString() : '—';
                document.getElementById('viewDescription').innerText = p.description || 'No description.';
                document.getElementById('viewProgressText').innerText = p.progress + '%';
                document.getElementById('viewProgressBar').style.width = p.progress + '%';

                // Timeline
                const start = p.startDate ? new Date(p.startDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'No start';
                const end = p.deadline ? new Date(p.deadline).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'No deadline';
                document.getElementById('viewTimeline').innerText = `${start} → ${end}`;

                // Status badge
                const sEl = document.getElementById('viewStatus');
                sEl.innerText = p.status;
                sEl.className = 'px-3 py-1 text-sm font-bold rounded-full ';
                if (p.status === 'Active') sEl.classList.add('bg-emerald-100','text-emerald-700');
                else if (p.status === 'AtRisk') sEl.classList.add('bg-amber-100','text-amber-700');
                else if (p.status === 'Completed') sEl.classList.add('bg-blue-100','text-blue-700');
                else if (p.status === 'OnHold') sEl.classList.add('bg-gray-200','text-gray-700');
                else sEl.classList.add('bg-purple-100','text-purple-700');

                // Priority badge
                const pEl = document.getElementById('viewPriority');
                pEl.innerText = p.priority;
                pEl.className = 'px-3 py-1 text-sm font-bold rounded-full ';
                if (p.priority === 'Critical') pEl.classList.add('bg-red-100','text-red-700');
                else if (p.priority === 'High') pEl.classList.add('bg-orange-100','text-orange-700');
                else if (p.priority === 'Medium') pEl.classList.add('bg-amber-100','text-amber-700');
                else pEl.classList.add('bg-gray-100','text-gray-600');

                // PM
                document.getElementById('viewPMName').innerText = p.projectManagerName || 'Unassigned';
                document.getElementById('viewPMEmail').innerText = p.projectManagerName ? 'Assigned' : 'No PM assigned';
                document.getElementById('viewPMAvatar').src = p.projectManagerPicture
                    || `https://i.pravatar.cc/100?u=${p.projectManagerId || 'default'}`;

                openModal('viewProjectModal');
            } catch (err) { console.error(err); }
        }

        // ============ EDIT PROJECT ============
        async function openEditModal(id) {
            try {
                const res = await fetch(`/Projects/GetProject/${id}`);
                if (!res.ok) return;
                const p = await res.json();

                document.getElementById('editId').value = p.id;
                document.getElementById('editName').value = p.name;
                document.getElementById('editClient').value = p.client || '';
                document.getElementById('editDomain').value = p.domain || '';
                document.getElementById('editPriority').value = p.priority;
                document.getElementById('editStartDate').value = p.startDate || '';
                document.getElementById('editDeadline').value = p.deadline || '';
                document.getElementById('editBudget').value = p.budget || '';
                document.getElementById('editDescription').value = p.description || '';

                const pmEl = document.getElementById('editPM');
                if (pmEl) pmEl.value = p.projectManagerId || '';

                document.getElementById('editProjectError').classList.add('hidden');
                openModal('editProjectModal');
            } catch (err) { console.error(err); }
        }

        async function updateProject() {
            const id = document.getElementById('editId').value;
            const name = document.getElementById('editName').value.trim();

            const errEl = document.getElementById('editProjectError');
            const errText = document.getElementById('editProjectErrorText');

            if (!name) { errText.innerText = 'Project name is required.'; errEl.classList.remove('hidden'); return; }
            errEl.classList.add('hidden');

            const fd = new FormData();
            fd.append('Id', id);
            fd.append('Name', name);
            fd.append('Client', document.getElementById('editClient').value);
            fd.append('Domain', document.getElementById('editDomain').value);
            fd.append('Priority', document.getElementById('editPriority').value);
            fd.append('Status', document.getElementById('editStatus').value);
            const sd = document.getElementById('editStartDate').value;
            const dl = document.getElementById('editDeadline').value;
            if (sd) fd.append('StartDate', sd);
            if (dl) fd.append('Deadline', dl);
            const b = document.getElementById('editBudget').value;
            if (b) fd.append('Budget', b);
            fd.append('Progress', document.getElementById('editProgress').value);
            fd.append('Description', document.getElementById('editDescription').value);

            const pmEl = document.getElementById('editPM');
            if (pmEl) fd.append('ProjectManagerId', pmEl.value);

            fd.append('__RequestVerificationToken', getToken());

            try {
                const res = await fetch('/Projects/UpdateProject', { method: 'POST', body: fd });
                const result = await res.json();

                if (result.success) {
                    closeModal('editProjectModal');
                    showToast(result.message, 'success');
                    setTimeout(() => window.location.reload(), 900);
                } else {
                    errText.innerText = result.message;
                    errEl.classList.remove('hidden');
                }
            } catch {
                errText.innerText = 'Network error.';
                errEl.classList.remove('hidden');
            }
        }

        // ============ DELETE PROJECT ============
        function openDeleteModal(id, name) {
            deletingId = id;
            document.getElementById('deleteProjectName').innerText = name;
            openModal('deleteProjectModal');
        }

        async function confirmDelete() {
            if (!deletingId) return;

            const fd = new FormData();
            fd.append('id', deletingId);
            fd.append('__RequestVerificationToken', getToken());

            try {
                const res = await fetch('/Projects/DeleteProject', { method: 'POST', body: fd });
                const result = await res.json();

                if (result.success) {
                    closeModal('deleteProjectModal');
                    showToast(result.message, 'success');
                    setTimeout(() => window.location.reload(), 800);
                } else {
                    showToast(result.message, 'error');
                }
            } catch {
                showToast('Network error.', 'error');
            }
        }

        // ============ SEARCH & FILTER ============
        function filterProjects() {
            const q = document.getElementById('projectSearch').value.toLowerCase();
            document.querySelectorAll('.project-card').forEach(card => {
                const text = ((card.dataset.name || '') + ' ' + (card.dataset.client || '')).toLowerCase();
                card.style.display = text.includes(q) ? '' : 'none';
            });
        }

        function filterByStatus(status, btn) {
            document.querySelectorAll('.filter-btn').forEach(b => {
                b.className = 'filter-btn px-5 py-2.5 bg-white text-gray-700 text-sm font-semibold rounded-full hover:bg-gray-50 shadow-sm border border-gray-200';
            });
            btn.className = 'filter-btn px-5 py-2.5 bg-brand text-sidebar text-sm font-bold rounded-full shadow-sm';

            document.querySelectorAll('.project-card').forEach(card => {
                card.style.display = (status === 'all' || card.dataset.status === status) ? '' : 'none';
            });
        }

        // ============ TOAST ============
        function showToast(message, type = 'success') {
            const bg = type === 'success' ? 'bg-emerald-500' : 'bg-red-500';
            const toast = document.createElement('div');
            toast.className = `fixed top-6 right-6 z-[60] ${bg} text-white px-6 py-4 rounded-xl shadow-2xl font-semibold text-base transition-all duration-300`;
            toast.innerText = message;
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }
    </script>
}