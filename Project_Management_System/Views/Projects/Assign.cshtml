@{
    ViewData["Title"] = "Assign Projects";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var unassigned = ViewBag.Unassigned as IEnumerable<dynamic> ?? new List<dynamic>();
    var managers = ViewBag.Managers as IEnumerable<dynamic> ?? new List<dynamic>();
    var assignedMap = ViewBag.AssignedMap as Dictionary<Guid, List<dynamic>> ?? new Dictionary<Guid, List<dynamic>>();
}

<div class="bg-gray-100 min-h-screen p-6">

    @Html.AntiForgeryToken()

    <!-- Page Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
        <div>
            <h1 class="text-4xl font-bold text-gray-900 flex items-center gap-3">
                <svg class="w-10 h-10 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                Assign Projects
            </h1>
            <p class="text-lg text-gray-600 mt-2 font-medium">Drag projects from the left and drop them onto a Project Manager on the right.</p>
        </div>
        <a asp-controller="Projects" asp-action="Index" class="px-5 py-2.5 bg-white border border-gray-300 text-gray-700 text-base font-semibold rounded-lg hover:bg-gray-50 transition-colors shadow-sm flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            Back to Projects
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

        <!-- ============================================= -->
        <!-- LEFT: UNASSIGNED PROJECTS                      -->
        <!-- ============================================= -->
        <div class="bg-white rounded-xl shadow-lg border border-gray-100 p-6 flex flex-col h-[calc(100vh-220px)]">

            <div class="flex justify-between items-center mb-5 pb-4 border-b border-gray-100">
                <div>
                    <h2 class="text-xl font-bold text-gray-900">Unassigned Projects</h2>
                    <p class="text-sm text-gray-500 mt-1">Drag a project to assign it</p>
                </div>
                <span class="px-3 py-1 text-sm font-semibold bg-gray-100 text-gray-600 rounded-full" id="unassignedCount">
                    @(unassigned.Count()) Project@(unassigned.Count() != 1 ? "s" : "")
                </span>
            </div>

            <div class="overflow-y-auto flex-1 space-y-4 pr-2" id="projectList">

                @if (!unassigned.Any())
                {
                    <div class="text-center py-12">
                        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gray-100 flex items-center justify-center">
                            <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                        <p class="text-base font-bold text-gray-700 mb-1">All projects are assigned</p>
                        <p class="text-sm text-gray-500">No unassigned projects in your organization.</p>
                    </div>
                }

                @foreach (var p in unassigned)
                {
                    var statusStr = p.Status.ToString();
                    var statusClass = statusStr switch
                    {
                        "Active" => "bg-emerald-100 text-emerald-700",
                        "AtRisk" => "bg-amber-100 text-amber-700",
                        "Completed" => "bg-blue-100 text-blue-700",
                        "Planning" => "bg-purple-100 text-purple-700",
                        "OnHold" => "bg-gray-200 text-gray-700",
                        _ => "bg-gray-100 text-gray-600"
                    };

                    var priorityStr = p.Priority.ToString();
                    var priorityClass = priorityStr switch
                    {
                        "Critical" => "bg-red-100 text-red-700",
                        "High" => "bg-orange-100 text-orange-700",
                        "Medium" => "bg-amber-100 text-amber-700",
                        _ => "bg-gray-100 text-gray-600"
                    };

                    var projId = (Guid)p.Id;
                    var projName = (string)p.Name;
                    var projNameJs = System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(projName);

                    <div class="project-card bg-gray-50 rounded-lg border border-gray-200 p-4 cursor-grab active:cursor-grabbing hover:border-brand transition-colors"
                         draggable="true"
                         ondragstart="dragStart(event, '@projId', '@projNameJs')"
                         id="proj-@projId">

                        <div class="flex justify-between items-start mb-2">
                            <div class="flex flex-wrap gap-1.5">
                                <span class="px-2.5 py-1 text-xs font-bold @statusClass rounded-full">@statusStr</span>
                                <span class="px-2.5 py-1 text-xs font-bold @priorityClass rounded-full">@priorityStr</span>
                            </div>
                        </div>

                        <h3 class="text-lg font-bold text-gray-900">@p.Name</h3>
                        <p class="text-sm text-gray-500 mb-1">@(p.Client ?? "No client")</p>

                        @if (p.Domain != null)
                        {
                            <span class="inline-block px-2 py-0.5 text-xs font-semibold bg-blue-50 text-blue-700 rounded-full mt-1">
                                🏷️ @p.Domain
                            </span>
                        }

                        <!-- Manual Assign Dropdown -->
                        @if (managers.Any())
                        {
                            <div class="flex items-center gap-2 mt-3 pt-3 border-t border-gray-200">
                                <label class="text-xs font-medium text-gray-500 whitespace-nowrap">Assign to:</label>
                                <select onchange="manualAssign(this, '@projId', '@projNameJs')"
                                        class="flex-1 text-xs bg-white border border-gray-300 text-gray-700 rounded-md px-2 py-1.5 focus:outline-none focus:ring-1 focus:ring-brand">
                                    <option value="">Select Manager...</option>
                                    @foreach (var m in managers)
                                    {
                                        <option value="@m.Id">@m.FullName</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>
                }

            </div>
        </div>

        <!-- ============================================= -->
        <!-- RIGHT: PROJECT MANAGERS                        -->
        <!-- ============================================= -->
        <div class="bg-white rounded-xl shadow-lg border border-gray-100 p-6 flex flex-col h-[calc(100vh-220px)]">

            <div class="flex justify-between items-center mb-5 pb-4 border-b border-gray-100">
                <div>
                    <h2 class="text-xl font-bold text-gray-900">Project Managers</h2>
                    <p class="text-sm text-gray-500 mt-1">Drop projects here to assign</p>
                </div>
                <span class="px-3 py-1 text-sm font-semibold bg-emerald-100 text-emerald-700 rounded-full">
                    @managers.Count() Manager@(managers.Count() != 1 ? "s" : "")
                </span>
            </div>

            <div class="overflow-y-auto flex-1 space-y-5 pr-2">

                @if (!managers.Any())
                {
                    <div class="text-center py-12">
                        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-amber-100 flex items-center justify-center">
                            <svg class="w-8 h-8 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                            </svg>
                        </div>
                        <p class="text-base font-bold text-gray-700 mb-1">No Project Managers yet</p>
                        <p class="text-sm text-gray-500 mb-4">Ask your System Administrator to create Project Managers first.</p>
                    </div>
                }

                @foreach (var m in managers)
                {
                    var managerId = (Guid)m.Id;
                    var managerKey = managerId.ToString("N"); // safe DOM key
                    var managerName = (string)m.FullName;
                    var managerNameJs = System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(managerName);

                   
                    // Load assigned projects for this manager
                    List<dynamic> assigned = new List<dynamic>();
                    if (assignedMap.TryGetValue(managerId, out var found))
                    {
                        assigned = found;
                    }

                    var avatarUrl = string.IsNullOrEmpty((string?)m.ProfilePictureUrl)
                    ? $"https://i.pravatar.cc/100?u={managerId}"
                    : (string)m.ProfilePictureUrl;

                    <div class="manager-card border border-gray-200 rounded-xl p-4 transition-colors"
                         ondragover="dragOver(event)"
                         ondragleave="dragLeave(event)"
                         ondrop="drop(event, '@managerId', '@managerNameJs')"
                         id="drop-@managerKey">

                        <div class="flex items-center gap-4 mb-3">
                            <img class="w-12 h-12 rounded-full border-2 border-white shadow-sm object-cover"
                                 src="@avatarUrl" alt="">
                            <div class="flex-1 min-w-0">
                                <h3 class="text-lg font-bold text-gray-900 truncate">@managerName</h3>
                                <p class="text-sm text-gray-500 truncate">@m.Email</p>
                            </div>

                            <!-- Assigned projects count tag -->
                            <div id="count-@managerKey"
                                 class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 shrink-0"
                                 data-count="@assigned.Count">
                                <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                                          d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                                </svg>
                                <span class="text-sm font-bold text-emerald-700 count-text">
                                    @assigned.Count Project@(assigned.Count != 1 ? "s" : "")
                                </span>
                            </div>
                        </div>

                        <!-- Drop Zone / Assigned list -->
                        <div class="min-h-[60px] border-2 border-dashed border-gray-300 rounded-lg p-3 flex flex-col gap-2 bg-gray-50"
                             id="assigned-@managerKey">

                            @if (assigned.Count == 0)
                            {
                                <p class="text-xs text-gray-400 italic text-center mt-2 placeholder-text">Drop projects here to assign</p>
                            }
                            else
                            {
                                foreach (var ap in assigned)
                                {
                                    var apId = (Guid)ap.Id;
                                    var apName = (string)ap.Name;
                                    var apNameJs = System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(apName);

                                    <div class="assigned-tag bg-white border border-gray-200 rounded-md p-2 flex justify-between items-center shadow-sm"
                                         data-project-id="@apId">
                                        <span class="text-sm font-medium text-gray-800 truncate">@apName</span>
                                        <button onclick="unassignProject('@apId', '@managerKey', this)"
                                                class="text-gray-400 hover:text-red-500 transition-colors shrink-0 ml-2"
                                                title="Unassign">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                            </svg>
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        // ============================================
        // STATE
        // ============================================
        let draggedProjectId = null;
        let draggedProjectName = null;

        function getToken() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        // ============================================
        // DRAG & DROP
        // ============================================
        function dragStart(event, projectId, projectName) {
            draggedProjectId = projectId;
            draggedProjectName = projectName;
            event.dataTransfer.effectAllowed = 'move';
            event.dataTransfer.setData('text/plain', projectId);
            event.target.classList.add('opacity-50');
        }

        function dragOver(event) {
            event.preventDefault();
            event.dataTransfer.dropEffect = 'move';
            event.currentTarget.classList.add('border-brand', 'bg-brand/5');
        }

        function dragLeave(event) {
            event.currentTarget.classList.remove('border-brand', 'bg-brand/5');
        }

        async function drop(event, managerId, managerName) {
            event.preventDefault();

            document.querySelectorAll('[id^="drop-"]').forEach(el => {
                el.classList.remove('border-brand', 'bg-brand/5');
            });

            document.querySelectorAll('.project-card').forEach(el => {
                el.classList.remove('opacity-50');
            });

            if (!draggedProjectId) return;

            // Call the API
            const ok = await assignProject(draggedProjectId, managerId, draggedProjectName, managerName);

            if (ok) {
                // Remove from left panel
                const card = document.getElementById('proj-' + draggedProjectId);
                if (card) card.remove();

                // Add tag to the manager's drop zone
                const managerKey = managerId.replace(/-/g, '');
                addProjectTag(managerKey, draggedProjectId, draggedProjectName);

                // Update counts
                updateUnassignedCount();
                updateManagerCount(managerKey);
            }

            draggedProjectId = null;
            draggedProjectName = null;
        }

        // ============================================
        // MANUAL ASSIGN (dropdown)
        // ============================================
        async function manualAssign(selectEl, projectId, projectName) {
            const managerId = selectEl.value;
            if (!managerId) return;

            const managerName = selectEl.options[selectEl.selectedIndex].text;
            const ok = await assignProject(projectId, managerId, projectName, managerName);

            if (ok) {
                // Remove from left
                const card = document.getElementById('proj-' + projectId);
                if (card) card.remove();

                // Add to right
                const managerKey = managerId.replace(/-/g, '');
                addProjectTag(managerKey, projectId, projectName);

                // Update counts
                updateUnassignedCount();
                updateManagerCount(managerKey);
            }

            selectEl.value = '';
        }

        // ============================================
        // API CALLS
        // ============================================
         async function assignProject(projectId, managerId, projectName, managerName) {
            try {
                const fd = new FormData();
                fd.append('projectId', projectId);
                fd.append('managerId', managerId);
                fd.append('__RequestVerificationToken', getToken());

                const res = await fetch('/Projects/AssignProject', { method: 'POST', body: fd });

                // ⬇️ Check status BEFORE parsing JSON
                if (!res.ok) {
                    const text = await res.text();
                    console.error('Server returned', res.status, text);
                    showToast(`Error ${res.status}: ${text.substring(0, 100)}`, 'error');
                    return false;
                }

                const result = await res.json();

                if (result.success) {
                    showToast(result.message, 'success');
                    return true;
                } else {
                    showToast(result.message || 'Failed to assign.', 'error');
                    return false;
                }
            } catch (err) {
                console.error('Assign error:', err);
                showToast('Error: ' + err.message, 'error');
                return false;
            }
        }

                async function unassignProject(projectId, managerKey, button) {
            if (!confirm('Unassign this project from the manager?')) return;

            try {
                const fd = new FormData();
                fd.append('projectId', projectId);
                fd.append('__RequestVerificationToken', getToken());

                const res = await fetch('/Projects/UnassignProject', { method: 'POST', body: fd });

                if (!res.ok) {
                    const text = await res.text();
                    console.error('Server returned', res.status, text);
                    showToast(`Error ${res.status}: ${text.substring(0, 100)}`, 'error');
                    return;
                }

                const result = await res.json();

                if (result.success) {
                    const tag = button.closest('.assigned-tag');
                    const projectName = tag.querySelector('span').innerText;

                    tag.remove();
                    updateManagerCount(managerKey);
                    createUnassignedCard(projectId, projectName);

                    showToast('Project unassigned.', 'success');
                } else {
                    showToast(result.message || 'Failed to unassign.', 'error');
                }
            } catch (err) {
                console.error('Unassign error:', err);
                showToast('Error: ' + err.message, 'error');
            }
        }

        // ============================================
        // UI HELPERS
        // ============================================
        function addProjectTag(managerKey, projectId, projectName) {
            const container = document.getElementById('assigned-' + managerKey);
            if (!container) return;

            // Remove placeholder text if present
            const placeholder = container.querySelector('.placeholder-text');
            if (placeholder) placeholder.remove();

            const tag = document.createElement('div');
            tag.className = 'assigned-tag bg-white border border-gray-200 rounded-md p-2 flex justify-between items-center shadow-sm';
            tag.dataset.projectId = projectId;
            tag.innerHTML = `
                <span class="text-sm font-medium text-gray-800 truncate">${escapeHtml(projectName)}</span>
                <button onclick="unassignProject('${projectId}', '${managerKey}', this)"
                        class="text-gray-400 hover:text-red-500 transition-colors shrink-0 ml-2"
                        title="Unassign">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            `;
            container.appendChild(tag);
        }

        function createUnassignedCard(projectId, projectName) {
            const list = document.getElementById('projectList');
            if (!list) return;

            // Remove empty state if present
            const emptyState = list.querySelector('.text-center.py-12');
            if (emptyState) emptyState.remove();

            const card = document.createElement('div');
            card.className = 'project-card bg-gray-50 rounded-lg border border-gray-200 p-4 cursor-grab active:cursor-grabbing hover:border-brand transition-colors';
            card.setAttribute('draggable', 'true');
            card.setAttribute('ondragstart', `dragStart(event, '${projectId}', '${escapeJs(projectName)}')`);
            card.id = 'proj-' + projectId;

            card.innerHTML = `
                <div class="flex justify-between items-start mb-2">
                    <span class="px-2.5 py-1 text-xs font-bold bg-gray-200 text-gray-700 rounded-full">Unassigned</span>
                </div>
                <h3 class="text-lg font-bold text-gray-900">${escapeHtml(projectName)}</h3>
                <p class="text-sm text-gray-500 mb-1">No client</p>
            `;

            list.appendChild(card);
        }

        function updateManagerCount(managerKey) {
            const container = document.getElementById('assigned-' + managerKey);
            const countEl = document.getElementById('count-' + managerKey);
            if (!container || !countEl) return;

            const count = container.querySelectorAll('.assigned-tag').length;
            countEl.innerText = count;

            // Add placeholder back if empty
            if (count === 0 && !container.querySelector('.placeholder-text')) {
                const p = document.createElement('p');
                p.className = 'text-xs text-gray-400 italic text-center mt-2 placeholder-text';
                p.innerText = 'Drop projects here to assign';
                container.appendChild(p);
            }
        }

        function updateUnassignedCount() {
            const list = document.getElementById('projectList');
            const countEl = document.getElementById('unassignedCount');
            if (!list || !countEl) return;

            const count = list.querySelectorAll('.project-card').length;
            countEl.innerText = count + ' Project' + (count !== 1 ? 's' : '');
        }

        // ============================================
        // XSS helpers
        // ============================================
        function escapeHtml(s) {
            if (!s) return '';
            return s.replace(/[&<>"']/g, c => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            }[c]));
        }

        function escapeJs(s) {
            if (!s) return '';
            return s.replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '\\"');
        }

        // ============================================
        // TOAST
        // ============================================
        function showToast(message, type = 'success') {
            const bg = type === 'success' ? 'bg-emerald-500' : 'bg-red-500';
            const toast = document.createElement('div');
            toast.className = `fixed top-6 right-6 z-[60] ${bg} text-white px-6 py-4 rounded-xl shadow-2xl font-semibold text-base transition-all duration-300`;
            toast.innerText = message;
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }
    </script>
}