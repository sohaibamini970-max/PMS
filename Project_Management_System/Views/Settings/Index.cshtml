@model Project_Management_System.ViewModels.SettingsViewModel
@{
    ViewData["Title"] = "Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Fallback avatar if none saved
    var avatarUrl = !string.IsNullOrEmpty(Model.ProfilePictureUrl)
        ? Model.ProfilePictureUrl
        : $"https://i.pravatar.cc/300?u={Model.Id}";

    var roleClass = Model.Role switch
    {
        "ExecutiveManager" => "bg-purple-100 text-purple-700",
        "SystemAdmin" => "bg-red-100 text-red-700",
        "ProjectManager" => "bg-blue-100 text-blue-700",
        "Member" => "bg-gray-100 text-gray-700",
        _ => "bg-gray-100 text-gray-700"
    };
    var roleLabel = Model.Role switch
    {
        "ExecutiveManager" => "EXECUTIVE",
        "SystemAdmin" => "SYSTEM ADMIN",
        "ProjectManager" => "PROJECT MANAGER",
        "Member" => "MEMBER",
        _ => Model.Role.ToUpper()
    };
}

<div class="bg-gray-100 min-h-screen p-6">

    @Html.AntiForgeryToken()

    <!-- Page Header -->
    <div class="mb-6">
        <h1 class="text-4xl font-bold text-gray-900 flex items-center gap-3">
            <svg class="w-10 h-10 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            Settings
        </h1>
        <p class="text-lg text-gray-600 mt-2 font-medium">Manage your profile picture and account password.</p>
    </div>

    <!-- Two-Column Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

        <!-- Sidebar -->
        <div class="lg:col-span-3">
            <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-3 sticky top-6">

                <p class="px-3 pt-3 pb-2 text-xs font-black text-gray-400 uppercase tracking-wider">Account Settings</p>

                <nav class="space-y-1">
                    <button onclick="switchTab('profile', this)" id="tabBtnProfile"
                            class="settings-tab active w-full flex items-center gap-3 px-4 py-3.5 rounded-xl text-base font-bold transition-all text-left">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        Profile Picture
                    </button>

                    <button onclick="switchTab('password', this)" id="tabBtnPassword"
                            class="settings-tab w-full flex items-center gap-3 px-4 py-3.5 rounded-xl text-base font-bold transition-all text-left">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                        </svg>
                        Change Password
                    </button>
                </nav>

                <!-- User info card -->
                <div class="mt-4 p-4 bg-gradient-to-br from-blue-50 to-indigo-50 border border-blue-200 rounded-xl">
                    <div class="flex items-center gap-3 mb-3">
                        <img id="sidePanelAvatar" class="w-12 h-12 rounded-full border-2 border-white shadow-md object-cover"
                             src="@avatarUrl" alt="">
                        <div class="min-w-0">
                            <p class="text-sm font-bold text-gray-900 truncate">@Model.FullName</p>
                            <p class="text-xs text-gray-500 font-medium truncate">@Model.Email</p>
                        </div>
                    </div>
                    <span class="inline-block px-2.5 py-1 text-xs font-black @roleClass rounded-full">@roleLabel</span>
                </div>

            </div>
        </div>

        <!-- Content -->
        <div class="lg:col-span-9">

            <!-- TAB 1: Profile Picture -->
            <div id="tabProfile" class="settings-panel">
                <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">

                    <div class="bg-gradient-to-r from-blue-500 to-indigo-600 px-6 py-5">
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 rounded-xl bg-white/20 backdrop-blur-sm flex items-center justify-center text-white shadow">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                </svg>
                            </div>
                            <div>
                                <h2 class="text-2xl font-black text-white drop-shadow">Profile Picture</h2>
                                <p class="text-sm text-blue-100 font-semibold">Upload a new avatar or choose from presets</p>
                            </div>
                        </div>
                    </div>

                    <div class="p-6 md:p-8">

                        <div class="flex flex-col md:flex-row items-center gap-8 mb-8 pb-8 border-b border-gray-100">

                            <div class="relative shrink-0">
                                <img id="profileAvatarPreview"
                                     class="w-40 h-40 rounded-full border-4 border-white shadow-2xl object-cover"
                                     src="@avatarUrl" alt="">
                                <div class="absolute bottom-2 right-2 w-10 h-10 rounded-full bg-brand flex items-center justify-center shadow-lg border-4 border-white">
                                    <svg class="w-5 h-5 text-sidebar" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    </svg>
                                </div>
                            </div>

                            <div class="flex-1 text-center md:text-left">
                                <h3 class="text-2xl font-bold text-gray-900 mb-2">Your Profile Photo</h3>
                                <p class="text-base text-gray-600 font-medium mb-5">
                                    Upload a JPG, PNG, or GIF file. Recommended: 400×400 px, max 5 MB.
                                </p>

                                <div class="flex flex-wrap gap-3 justify-center md:justify-start">
                                    <label class="cursor-pointer px-5 py-3 bg-brand text-sidebar text-base font-bold rounded-lg hover:bg-yellow-400 transition-colors shadow-glow flex items-center gap-2">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
                                        </svg>
                                        Upload New Photo
                                        <input type="file" id="avatarFileInput" accept="image/*" class="hidden" onchange="uploadAvatar(event)">
                                    </label>

                                    <button onclick="removeAvatar()" class="px-5 py-3 bg-white border-2 border-gray-200 text-gray-700 text-base font-bold rounded-lg hover:border-red-300 hover:text-red-600 hover:bg-red-50 transition-colors flex items-center gap-2">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                        </svg>
                                        Remove
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Presets -->
                        <div class="mb-2">
                            <h3 class="text-xl font-bold text-gray-900 mb-2">Or Choose a Preset</h3>
                            <p class="text-base text-gray-600 font-medium mb-5">Pick a default avatar if you prefer not to upload your own.</p>

                            <div class="grid grid-cols-4 md:grid-cols-6 gap-4">
                                @{
                                    var presets = new[]
                                    {
                                                                "https://i.pravatar.cc/300?img=1",
                                                                "https://i.pravatar.cc/300?img=3",
                                                                "https://i.pravatar.cc/300?img=5",
                                                                "https://i.pravatar.cc/300?img=6",
                                                                "https://i.pravatar.cc/300?img=8",
                                                                "https://i.pravatar.cc/300?img=9",
                                                                };
                                }
                                @foreach (var url in presets)
                                {
                                    <button type="button" onclick="selectPreset(this, '@url')" class="preset-avatar group relative">
                                        <img class="w-full aspect-square rounded-xl border-4 border-white shadow-md hover:shadow-xl hover:scale-105 transition-all cursor-pointer object-cover"
                                             src="@url" alt="">
                                    </button>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- TAB 2: Change Password -->
            <div id="tabPassword" class="settings-panel" style="display: none;">
                <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">

                    <div class="bg-gradient-to-r from-red-500 to-rose-600 px-6 py-5">
                        <div class="flex items-center gap-3">
                            <div class="w-12 h-12 rounded-xl bg-white/20 backdrop-blur-sm flex items-center justify-center text-white shadow">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                                </svg>
                            </div>
                            <div>
                                <h2 class="text-2xl font-black text-white drop-shadow">Change Password</h2>
                                <p class="text-sm text-red-100 font-semibold">Keep your account secure with a strong password</p>
                            </div>
                        </div>
                    </div>

                    <div class="p-6 md:p-8">

                        <div class="max-w-2xl space-y-5">

                            <div>
                                <label class="block text-base font-bold text-gray-700 mb-2">New Password</label>
                                <div class="relative">
                                    <svg class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
                                    </svg>
                                    <input type="password" id="newPassword" oninput="checkPasswordStrength(); checkPasswordMatch();"
                                           placeholder="Enter new password"
                                           class="w-full bg-white border border-gray-300 text-gray-900 text-base rounded-lg pl-12 pr-14 py-3.5 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent">
                                    <button type="button" onclick="togglePasswordVisibility('newPassword', this)"
                                            class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-700">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                        </svg>
                                    </button>
                                </div>

                                <div class="mt-3">
                                    <div class="flex gap-1.5 mb-2">
                                        <div id="strengthBar1" class="flex-1 h-1.5 rounded-full bg-gray-200"></div>
                                        <div id="strengthBar2" class="flex-1 h-1.5 rounded-full bg-gray-200"></div>
                                    </div>
                                    <p id="strengthText" class="text-sm font-bold text-gray-400">Enter a password to see strength</p>
                                </div>
                            </div>

                            <div>
                                <label class="block text-base font-bold text-gray-700 mb-2">Confirm New Password</label>
                                <div class="relative">
                                    <svg class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    <input type="password" id="confirmPassword" oninput="checkPasswordMatch()"
                                           placeholder="Re-enter new password"
                                           class="w-full bg-white border border-gray-300 text-gray-900 text-base rounded-lg pl-12 pr-14 py-3.5 focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent">
                                    <button type="button" onclick="togglePasswordVisibility('confirmPassword', this)"
                                            class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-700">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                        </svg>
                                    </button>
                                </div>
                                <p id="matchText" class="text-sm font-bold mt-2 hidden"></p>
                            </div>

                        </div>

                        <div class="flex flex-col sm:flex-row justify-end gap-3 pt-6 mt-6 border-t border-gray-100">
                            <button onclick="clearPasswordForm()" class="px-6 py-3 bg-white border-2 border-gray-200 text-gray-700 text-base font-bold rounded-lg hover:bg-gray-50 transition-colors">
                                Cancel
                            </button>
                            <button onclick="savePassword()" id="btnSavePassword"
                                    class="px-6 py-3 bg-gradient-to-r from-red-500 to-rose-600 text-white text-base font-bold rounded-lg hover:from-red-600 hover:to-rose-700 transition-all shadow-lg shadow-red-500/30 flex items-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                                </svg>
                                Update Password
                            </button>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ============================================
        // STATE
        // ============================================
        let currentAvatarUrl = '@avatarUrl';

        function getToken() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        function showToast(message, type = 'success') {
            const bg = type === 'success' ? 'bg-emerald-500' : 'bg-red-500';
            const t = document.createElement('div');
            t.className = `fixed top-6 right-6 z-[60] ${bg} text-white px-6 py-4 rounded-xl shadow-2xl font-semibold text-base`;
            t.innerText = message;
            document.body.appendChild(t);
            setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 300); }, 3500);
        }

        // ============================================
        // TAB SWITCHING
        // ============================================
        function switchTab(tabName, btn) {
            document.querySelectorAll('.settings-panel').forEach(p => p.style.display = 'none');
            document.querySelectorAll('.settings-tab').forEach(t => {
                t.classList.remove('active');
                t.classList.add('text-gray-700', 'hover:bg-gray-50');
            });

            document.getElementById('tab' + capitalize(tabName)).style.display = 'block';
            btn.classList.add('active');
            btn.classList.remove('text-gray-700', 'hover:bg-gray-50');
        }
        function capitalize(s) { return s.charAt(0).toUpperCase() + s.slice(1); }

        // ============================================
        // AVATAR — Upload
        // ============================================
        async function uploadAvatar(event) {
            const file = event.target.files[0];
            if (!file) return;

            if (file.size > 5 * 1024 * 1024) {
                showToast('File is too large. Max 5 MB.', 'error');
                event.target.value = '';
                return;
            }

            // Instant preview
            const reader = new FileReader();
            reader.onload = e => {
                document.getElementById('profileAvatarPreview').src = e.target.result;
            };
            reader.readAsDataURL(file);

            // Upload to server
            const fd = new FormData();
            fd.append('file', file);
            fd.append('__RequestVerificationToken', getToken());

            try {
                const res = await fetch('/Settings/UploadAvatar', { method: 'POST', body: fd });
                const r = await res.json();
                if (r.success) {
                    currentAvatarUrl = r.url;
                    // Normalize URL with cache-buster so the browser refreshes
                    const freshUrl = r.url + '?t=' + Date.now();
                    document.getElementById('profileAvatarPreview').src = freshUrl;
                    document.getElementById('sidePanelAvatar').src = freshUrl;
                    showToast('Profile picture updated.');
                } else {
                    showToast(r.message, 'error');
                    // Revert the preview
                    document.getElementById('profileAvatarPreview').src = currentAvatarUrl;
                }
            } catch (e) {
                console.error(e);
                showToast('Upload failed.', 'error');
                document.getElementById('profileAvatarPreview').src = currentAvatarUrl;
            } finally {
                event.target.value = '';
            }
        }

        // ============================================
        // AVATAR — Preset
        // ============================================
        async function selectPreset(btn, url) {
            // Optimistic preview
            document.getElementById('profileAvatarPreview').src = url;

            const fd = new FormData();
            fd.append('url', url);
            fd.append('__RequestVerificationToken', getToken());

            try {
                const res = await fetch('/Settings/SavePreset', { method: 'POST', body: fd });
                const r = await res.json();
                if (r.success) {
                    currentAvatarUrl = url;
                    document.getElementById('profileAvatarPreview').src = url;
                    document.getElementById('sidePanelAvatar').src = url;
                    showToast('Preset applied.');
                } else {
                    showToast(r.message, 'error');
                    document.getElementById('profileAvatarPreview').src = currentAvatarUrl;
                }
            } catch {
                showToast('Network error.', 'error');
                document.getElementById('profileAvatarPreview').src = currentAvatarUrl;
            }
        }

        // ============================================
        // AVATAR — Remove
        // ============================================
        async function removeAvatar() {
            if (!confirm('Remove your profile picture?')) return;

            const fd = new FormData();
            fd.append('__RequestVerificationToken', getToken());

            try {
                const res = await fetch('/Settings/RemoveAvatar', { method: 'POST', body: fd });
                const r = await res.json();
                if (r.success) {
                    // Generate fallback based on userId (guaranteed unique per user)
                    const fallback = 'https://i.pravatar.cc/300?u=@Model.Id';
                    document.getElementById('profileAvatarPreview').src = fallback;
                    document.getElementById('sidePanelAvatar').src = fallback;
                    currentAvatarUrl = fallback;
                    showToast('Profile picture removed.');
                } else {
                    showToast(r.message, 'error');
                }
            } catch {
                showToast('Network error.', 'error');
            }
        }

        // ============================================
        // PASSWORD — Visibility Toggle
        // ============================================
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            if (input.type === 'password') {
                input.type = 'text';
                btn.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path></svg>`;
            } else {
                input.type = 'password';
                btn.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>`;
            }
        }

        // ============================================
        // PASSWORD — Strength
        // ============================================
        function checkPasswordStrength() {
            const pwd = document.getElementById('newPassword').value;
            const hasLength = pwd.length >= 8;
            const hasSymbol = /[!@@#$%^&*(),.?":{}|<>]/.test(pwd);

            let score = 0;
            if (hasLength) score++;
            if (hasSymbol) score++;

            for (let i = 1; i <= 2; i++) {
                const bar = document.getElementById('strengthBar' + i);
                bar.className = 'flex-1 h-1.5 rounded-full ' +
                    (i <= score ? (score === 2 ? 'bg-emerald-500' : 'bg-red-500') : 'bg-gray-200');
            }

            const strengthText = document.getElementById('strengthText');
            if (pwd === '') {
                strengthText.textContent = 'Enter a password to see strength';
                strengthText.className = 'text-sm font-bold text-gray-400';
            } else {
                strengthText.textContent = 'Strength: ' + (score === 2 ? 'Strong' : 'Weak');
                strengthText.className = 'text-sm font-bold ' + (score === 2 ? 'text-emerald-600' : 'text-red-600');
            }
        }

        // ============================================
        // PASSWORD — Match
        // ============================================
        function checkPasswordMatch() {
            const pwd = document.getElementById('newPassword').value;
            const confirm = document.getElementById('confirmPassword').value;
            const matchText = document.getElementById('matchText');

            if (confirm === '') {
                matchText.classList.add('hidden');
                return;
            }

            matchText.classList.remove('hidden');

            if (pwd === confirm) {
                matchText.textContent = '✓ Passwords match';
                matchText.className = 'text-sm font-bold mt-2 text-emerald-600';
            } else {
                matchText.textContent = '✗ Passwords do not match';
                matchText.className = 'text-sm font-bold mt-2 text-red-600';
            }
        }

        // ============================================
        // PASSWORD — Save
        // ============================================
        async function savePassword() {
            const newPwd = document.getElementById('newPassword').value;
            const confirm = document.getElementById('confirmPassword').value;

            if (!newPwd || !confirm) { showToast('Fill in both password fields.', 'error'); return; }
            if (newPwd !== confirm) { showToast('Passwords do not match.', 'error'); return; }
            if (newPwd.length < 8) { showToast('Password must be at least 8 characters.', 'error'); return; }

            const btn = document.getElementById('btnSavePassword');
            btn.disabled = true;

            const fd = new FormData();
            fd.append('newPassword', newPwd);
            fd.append('confirmPassword', confirm);
            fd.append('__RequestVerificationToken', getToken());

            try {
                const res = await fetch('/Settings/ChangePassword', { method: 'POST', body: fd });
                const r = await res.json();
                if (r.success) {
                    showToast(r.message);
                    clearPasswordForm();
                } else {
                    showToast(r.message, 'error');
                }
            } catch {
                showToast('Network error.', 'error');
            } finally {
                btn.disabled = false;
            }
        }

        function clearPasswordForm() {
            document.getElementById('newPassword').value = '';
            document.getElementById('confirmPassword').value = '';
            document.getElementById('matchText').classList.add('hidden');
            checkPasswordStrength();
        }
    </script>

    <style>
        .settings-tab.active {
            background-color: #FACC15;
            color: #15181D;
            box-shadow: 0 8px 24px -8px rgba(250, 204, 21, 0.45);
        }
    </style>
}