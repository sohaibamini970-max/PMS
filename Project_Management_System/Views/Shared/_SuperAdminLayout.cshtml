<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Platform Admin</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        brand: '#FACC15',
                        sidebar: '#1A0F2E',
                        sidebar2: '#251643',
                        purpleAccent: '#8B5CF6',
                    },
                    boxShadow: {
                        glow: '0 8px 24px -8px rgba(250, 204, 21, 0.45)',
                    }
                }
            }
        }
    </script>

    <style>
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #3b2a5c;
            border-radius: 4px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #4c3875;
            }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem;
            border-radius: 0.75rem;
            font-size: 0.95rem;
            font-weight: 600;
            color: #E5E7EB;
            transition: all 0.15s ease;
        }

            .nav-link:hover {
                background-color: #251643;
                color: #FACC15;
            }

                .nav-link:hover svg {
                    color: #FACC15;
                }

            .nav-link.active {
                background-color: #FACC15;
                color: #1A0F2E;
                box-shadow: 0 8px 24px -8px rgba(250, 204, 21, 0.45);
            }

                .nav-link.active svg {
                    color: #1A0F2E;
                }
    </style>
</head>
<body class="bg-gray-100 font-sans text-gray-800 antialiased h-screen overflow-hidden flex">

    @{
        // Extract user info from claims
        var userFullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Super Admin";
        var userEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
        var userPicture = User.FindFirst("ProfilePicture")?.Value;
        if (string.IsNullOrWhiteSpace(userPicture)) userPicture = "https://i.pravatar.cc/150?img=68";

        // Get initials for fallback
        var initials = string.IsNullOrWhiteSpace(userFullName)
        ? "SA"
        : string.Join("", userFullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpper();
    }

    <!-- ============================================= -->
    <!-- PLATFORM ADMIN SIDEBAR                         -->
    <!-- ============================================= -->
    <aside class="w-64 h-full flex flex-col justify-between flex-shrink-0 relative z-20 shadow-2xl"
           style="background-color: #1A0F2E;">

        <!-- Logo -->
        <div class="h-20 px-5 flex items-center gap-3 border-b border-white/10 flex-shrink-0">
            <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-purple-500 to-indigo-600 flex items-center justify-center flex-shrink-0 shadow-lg shadow-purple-500/50">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
            </div>
            <div class="min-w-0">
                <span class="block text-base font-black text-white whitespace-nowrap">PLATFORM</span>
                <span class="block text-xs font-bold text-purple-300 whitespace-nowrap">ADMIN PORTAL</span>
            </div>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-1">

            <a asp-controller="SuperAdmin" asp-action="Index"
               class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SuperAdmin" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                </svg>
                Organizations
            </a>

            <a href="#" class="nav-link">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
                All Users
                <span class="ml-auto text-[11px] font-bold px-2 py-0.5 rounded-full bg-white/10 text-purple-200">248</span>
            </a>

            <a href="#" class="nav-link">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
                Analytics
            </a>

            <a href="#" class="nav-link">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                </svg>
                Billing
            </a>

            <div class="border-t border-white/10 my-3"></div>

            <a asp-controller="Account" asp-action="Logout" class="nav-link">
                <svg class="w-5 h-5 flex-shrink-0 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                </svg>
                Logout
            </a>
        </nav>

        <!-- Footer user card -->
        <div class="p-3 border-t border-white/10 flex-shrink-0">
            <div class="flex items-center gap-3 p-3 rounded-xl" style="background-color: #251643;">
                <img class="w-9 h-9 rounded-full border-2 border-white/20 object-cover"
                     src="@userPicture"
                     onerror="this.onerror=null; this.src='https://i.pravatar.cc/150?img=68'"
                     alt="">
                <div class="min-w-0">
                    <p class="text-sm font-bold text-white truncate">@userFullName</p>
                    <p class="text-xs text-purple-300 truncate">Super Admin</p>
                </div>
            </div>
        </div>
    </aside>

    <!-- ============================================= -->
    <!-- MAIN CONTENT                                   -->
    <!-- ============================================= -->
    <main class="flex-1 flex flex-col h-full overflow-hidden min-w-0">

        <!-- Top Header -->
        <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-6 flex-shrink-0 shadow-sm">
            <h2 class="text-xl font-bold text-gray-900">Platform Administration</h2>
            <div class="flex items-center gap-3">
                <span class="px-3 py-1.5 text-xs font-black bg-purple-100 text-purple-700 rounded-full">👑 SUPER ADMIN</span>
                <img class="w-9 h-9 rounded-full border-2 border-gray-200 object-cover"
                     src="@userPicture"
                     onerror="this.onerror=null; this.src='https://i.pravatar.cc/150?img=68'"
                     alt="">
                <div class="leading-tight hidden sm:block">
                    <p class="text-sm font-bold text-gray-900">@userFullName</p>
                    <p class="text-xs text-gray-500">@userEmail</p>
                </div>
            </div>
        </header>

        <!-- Page Content -->
        <div class="flex-1 overflow-y-auto bg-gray-100 p-6">
            @RenderBody()
        </div>
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>