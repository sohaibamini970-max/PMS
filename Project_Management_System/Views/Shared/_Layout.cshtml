<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Project Management System</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        brand:    '#FACC15',
                        sidebar:  '#15181D',
                        sidebar2: '#1D2128',
                        section:  '#6B7280',
                        ink:      '#E5E7EB',
                        inkMuted: '#9CA3AF',
                        headerBlue: '#211475',
                    },
                    boxShadow: {
                        glow: '0 8px 24px -8px rgba(250, 204, 21, 0.45)',
                    }
                }
            }
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: #2f343d;
            border-radius: 4px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #3f4550;
            }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            padding: 0.65rem 0.85rem;
            border-radius: 0.75rem;
            font-size: 15px;
            line-height: 1.35;
            font-weight: 600;
            color: #FFFFFF;
            transition: all 0.15s ease;
        }

            .nav-link:hover {
                background-color: #1D2128;
                color: #FACC15;
            }

                .nav-link:hover svg {
                    color: #FACC15;
                }

            .nav-link.active {
                background-color: #FACC15;
                color: #15181D;
                box-shadow: 0 8px 24px -8px rgba(250, 204, 21, 0.45);
            }

                .nav-link.active svg {
                    color: #15181D;
                }

                .nav-link.active .badge {
                    background-color: rgba(21, 24, 29, 0.2);
                    color: #15181D;
                }

        .badge {
            margin-left: auto;
            font-size: 12px;
            line-height: 1;
            font-weight: 700;
            padding: 5px 9px;
            border-radius: 9999px;
            background-color: rgba(255, 255, 255, 0.10);
            color: #9CA3AF;
        }

        /* Section headings — bigger, more readable, on-brand colour */
        .section-label {
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.18em;
            color: #FACC15; /* brand yellow — swap for #60A5FA / #34D399 / #94A3B8 */
            padding-left: 0.85rem;
            margin-bottom: 0.6rem;
            opacity: 0.95;
        }
    </style>
</head>
<body class="bg-gray-200 font-sans text-gray-800 antialiased h-screen overflow-hidden flex">

    @{
        // ============================================
        // USER DATA FROM AUTH CLAIMS
        // ============================================
        var userFullName = User.FindFirst("FullName")?.Value
        ?? User.Identity?.Name
        ?? "User";

        var userEmail = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
        ?? "";

        var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
        ?? User.FindFirst("Role")?.Value
        ?? "Member";

        var orgName = User.FindFirst("OrganizationName")?.Value ?? "";

        var userPicture = User.FindFirst("ProfilePicture")?.Value;
        if (string.IsNullOrWhiteSpace(userPicture))
            userPicture = "https://i.pravatar.cc/150?img=11";

        var firstName = userFullName.Contains(' ')
        ? userFullName.Split(' ')[0]
        : userFullName;

        var hour = DateTime.Now.Hour;
        var greeting = hour < 12 ? "Good Morning"
        : hour < 17 ? "Good Afternoon"
        : "Good Evening";

        var roleDisplay = userRole switch
        {
            "SuperAdmin" => "Platform Owner",
            "SystemAdmin" => "System Administrator",
            "ExecutiveManager" => "Executive Manager",
            "ProjectManager" => "Project Manager",
            "Member" => "Member",
            _ => userRole
        };

        var rolePillClass = userRole switch
        {
            "SuperAdmin" => "bg-purple-100 text-purple-700",
            "SystemAdmin" => "bg-red-100 text-red-700",
            "ExecutiveManager" => "bg-amber-100 text-amber-700",
            "ProjectManager" => "bg-emerald-100 text-emerald-700",
            _ => "bg-blue-100 text-blue-700"
        };

        var greetingSubtitle = userRole switch
        {
            "SuperAdmin" => "Managing the entire platform",
            "SystemAdmin" => "Overseeing your organization",
            "ExecutiveManager" => "Here's the organization's progress today",
            "ProjectManager" => "Here's what's happening with your projects today",
            _ => "Here are your assigned tasks for today"
        };
    }

    <!-- ============================================= -->
    <!-- SIDEBAR                                        -->
    <!-- ============================================= -->
    <aside class="w-64 bg-sidebar h-full flex flex-col justify-between hidden md:flex">

        <!-- Logo -->
        <div class="h-20 px-5 flex items-center gap-3 bg-sidebar border-b border-white/5">
            <div class="w-9 h-9 rounded-lg bg-blue-600 flex items-center justify-center shadow-lg shadow-blue-500/50">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                          d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                </svg>
            </div>
            <div class="min-w-0">
                <span class="block text-xl font-black text-white tracking-tight"><span class="text-blue-400">PMS</span></span>
                @if (!string.IsNullOrEmpty(orgName))
                {
                    <span class="block text-sm font-bold text-emerald-400 truncate">@orgName</span>
                }
            </div>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 overflow-y-auto px-3 pb-6 space-y-6 pt-4">

            <!-- OVERVIEW -->
            <div>
                <p class="section-label">Overview</p>
                <div class="space-y-1">
                    <a asp-controller="Home" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                        <svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                  d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                        </svg>
                        Dashboard
                    </a>

                    <a asp-controller="Profile" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Profile" ? "active" : "")">
                        <svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                  d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Profile
                    </a>

                    @* ── Workflow (Timeline) — hidden for Member role ── *@
                    @if (!User.IsInRole("Member"))
                    {
                        <a asp-controller="Timeline" asp-action="Index"
                           class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Timeline" ? "active" : "")">
                            <svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                      d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM9 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4zM5 10v2a2 2 0 002 2h3M17 10v2a2 2 0 01-2 2h-3" />
                            </svg>
                            Workflow
                        </a>
                    }
                </div>
            </div>

            <!-- WORKSPACE -->
            <div>
                <p class="section-label">Workspace</p>
                <div class="space-y-1">
                    <a asp-controller="Projects" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Projects" ? "active" : "")">
                        <svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                        Projects
                    </a>

                    <a asp-controller="Tasks" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tasks" ? "active" : "")">
                        <svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                  d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                        </svg>
                        Tasks
                        <span class="badge">5</span>
                    </a>

                    <a asp-controller="Teams" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Teams" ? "active" : "")">
                        <svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        Teams
                    </a>

                    <a asp-controller="Tracking" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tracking" ? "active" : "")">
                        <svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                        </svg>
                        Insights
                    </a>
                </div>
            </div>

            <!-- RESOURCES -->
            <div>
                <p class="section-label">Resources</p>
                <div class="space-y-1">
                    <a asp-controller="Documents" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Documents" ? "active" : "")">
                        <svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                  d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                        </svg>
                        Documents
                    </a>
                    <a asp-controller="Settings" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")">
                        <svg class="w-[22px] h-[22px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"
                                  d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        Settings
                    </a>
                </div>
            </div>
        </nav>

        <!-- Bottom: User card + Logout -->
        <div class="p-3 border-t border-white/10 flex-shrink-0 space-y-2">

            <!-- Logout -->
            <a asp-controller="Account" asp-action="Logout"
               class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl transition-colors"
               style="background-color: #1D2128;">
                <svg class="w-[22px] h-[22px] flex-shrink-0 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                </svg>
                <span class="text-white font-semibold">Logout</span>
            </a>
        </div>
    </aside>

    <!-- ============================================= -->
    <!-- MAIN CONTENT AREA                              -->
    <!-- ============================================= -->
    <main class="flex-1 flex flex-col h-full relative overflow-hidden min-w-0">

        <!-- ============================================= -->
        <!-- TOP HEADER                                     -->
        <!-- ============================================= -->
        <header class="h-20 bg-headerBlue flex items-center justify-between px-6 z-10 shadow-lg flex-shrink-0">

            <!-- LEFT: Greeting -->
            <div class="hidden md:flex items-center gap-3">
                <div class="text-yellow-400">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
                    </svg>
                </div>
                <div>
                    <p class="text-xl font-bold text-white">@greeting, @firstName!</p>
                    <p class="text-base text-blue-200">@greetingSubtitle</p>
                </div>
            </div>

            <!-- RIGHT: Date, Notifications, Profile -->
            <div class="flex items-center gap-4">

                <!-- Today's Date -->
                <div class="hidden sm:flex items-center gap-2 bg-blue-800/40 px-3 py-2 rounded-lg text-base font-semibold text-white">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    @DateTime.Now.ToString("MMM dd, yyyy")
                </div>

                <!-- Notifications -->
                <button class="relative text-white hover:text-blue-200 transition-colors">
                    <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                    </svg>
                    <span class="absolute -top-1.5 -right-1.5 bg-red-500 text-white text-[11px] font-bold px-1.5 py-0.5 rounded-full border-2 border-headerBlue">3</span>
                </button>

                <!-- Profile -->
                <div class="flex items-center gap-3 pl-4 border-l border-blue-500/50">
                    <span class="hidden sm:inline-block px-3 py-1.5 text-sm font-black @rolePillClass rounded-full uppercase tracking-wider">@roleDisplay</span>
                    <img class="w-12 h-12 rounded-full border-2 border-white/50 shadow-sm object-cover"
                         src="@userPicture"
                         onerror="this.onerror=null; this.src='https://i.pravatar.cc/150?img=11'" alt="">
                    <div class="hidden sm:block text-left">
                        <p class="text-lg font-bold text-white leading-tight">@userFullName</p>
                        <p class="text-sm text-blue-200 leading-tight truncate max-w-[200px]">@userEmail</p>
                    </div>
                </div>

            </div>
        </header>

        <!-- PAGE CONTENT -->
        <div class="flex-1 overflow-y-auto bg-gray-50 p-6">
            @RenderBody()
        </div>
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>