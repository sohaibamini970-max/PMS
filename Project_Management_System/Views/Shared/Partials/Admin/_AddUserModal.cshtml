<div id="addUserModal" class="fixed inset-0 z-50 hidden bg-gray-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl overflow-hidden max-h-[90vh] flex flex-col">
        <div class="bg-gradient-to-r from-blue-500 to-indigo-600 px-6 py-5 flex justify-between items-center">
            <h3 class="text-xl font-bold text-white">Add New User</h3>
            <button onclick="closeModal('addUserModal')" class="text-white/80 hover:text-white p-1 rounded-full hover:bg-white/20">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <form class="p-6 space-y-5 overflow-y-auto">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Full Name *</label>
                    <input type="text" placeholder="John Doe" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand/60">
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Email *</label>
                    <input type="email" placeholder="john@argpms.com" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand/60">
                </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Role *</label>
                    <select class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand/60">
                        <option>Member</option>
                        <option>Project Manager</option>
                        <option>Admin</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Team</label>
                    <select class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand/60">
                        <option>None</option>
                        <option>Engineering</option>
                        <option>Design</option>
                    </select>
                </div>
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1.5">Password *</label>
                <input type="password" placeholder="Minimum 8 characters" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand/60">
            </div>
        </form>
        <div class="bg-gray-50 px-6 py-4 flex justify-end gap-3 border-t">
            <button onclick="closeModal('addUserModal')" class="px-5 py-2.5 border border-gray-300 rounded-lg text-sm font-semibold">Cancel</button>
            <button class="px-6 py-2.5 bg-brand text-sidebar rounded-lg text-sm font-bold">Create User</button>
        </div>
    </div>
</div>