@model Project_Management_System.ViewModels.TrackingViewModel
@{
    ViewData["Title"] = "Tracking";

    string TeamGradient(string color) => color switch
    {
        "emerald" => "from-emerald-500 via-emerald-400 to-teal-400",
        "purple" => "from-purple-500 via-purple-500 to-pink-500",
        "blue" => "from-blue-500 via-blue-500 to-indigo-500",
        "amber" => "from-amber-500 via-orange-500 to-orange-400",
        "red" => "from-red-500 via-red-500 to-rose-500",
        _ => "from-gray-500 via-gray-400 to-gray-500"
    };
    string TeamBorder(string color) => color switch
    {
        "emerald" => "border-emerald-300",
        "purple" => "border-purple-300",
        "blue" => "border-blue-300",
        "amber" => "border-amber-300",
        "red" => "border-red-300",
        _ => "border-gray-300"
    };

    var isPM = User.IsInRole("ProjectManager");
}

<div class="bg-gray-100 min-h-screen p-6">

    <!-- Page Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
        <div>
            <h1 class="text-4xl font-bold text-gray-900 flex items-center gap-3">
                <svg class="w-10 h-10 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
                Performance Tracking
            </h1>
            <p class="text-lg text-gray-600 mt-2 font-medium">
                @(isPM
                                ? "Monitor progress of teams and individuals on the projects you manage."
                                : "Monitor progress of teams and individuals across all projects.")
            </p>
        </div>
    </div>

    <!-- SUMMARY STAT CARDS -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mb-6">

        <div class="bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl shadow-lg p-6 text-white relative overflow-hidden">
            <div class="absolute -right-6 -top-6 w-32 h-32 bg-white/10 rounded-full"></div>
            <div class="relative">
                <div class="flex items-center justify-between mb-3">
                    <p class="text-sm font-bold text-blue-100 uppercase tracking-wide">Total Projects</p>
                    <svg class="w-7 h-7 text-blue-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                </div>
                <h3 class="text-5xl font-black">@Model.TotalProjects</h3>
                <p class="text-sm text-blue-100 font-medium mt-2">Being tracked</p>
            </div>
        </div>

        <div class="bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-xl shadow-lg p-6 text-white relative overflow-hidden">
            <div class="absolute -right-6 -top-6 w-32 h-32 bg-white/10 rounded-full"></div>
            <div class="relative">
                <div class="flex items-center justify-between mb-3">
                    <p class="text-sm font-bold text-emerald-100 uppercase tracking-wide">Completed</p>
                    <svg class="w-7 h-7 text-emerald-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <h3 class="text-5xl font-black">@Model.TotalCompletedTasks</h3>
                <p class="text-sm text-emerald-100 font-medium mt-2">Tasks completed</p>
            </div>
        </div>

        <div class="bg-gradient-to-br from-amber-500 to-orange-500 rounded-xl shadow-lg p-6 text-white relative overflow-hidden">
            <div class="absolute -right-6 -top-6 w-32 h-32 bg-white/10 rounded-full"></div>
            <div class="relative">
                <div class="flex items-center justify-between mb-3">
                    <p class="text-sm font-bold text-amber-100 uppercase tracking-wide">Pending</p>
                    <svg class="w-7 h-7 text-amber-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <h3 class="text-5xl font-black">@Model.TotalPendingTasks</h3>
                <p class="text-sm text-amber-100 font-medium mt-2">Tasks in progress</p>
            </div>
        </div>

        <div class="bg-gradient-to-br from-red-500 to-rose-600 rounded-xl shadow-lg p-6 text-white relative overflow-hidden">
            <div class="absolute -right-6 -top-6 w-32 h-32 bg-white/10 rounded-full"></div>
            <div class="relative">
                <div class="flex items-center justify-between mb-3">
                    <p class="text-sm font-bold text-red-100 uppercase tracking-wide">Overdue</p>
                    <svg class="w-7 h-7 text-red-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                </div>
                <h3 class="text-5xl font-black">@Model.TotalOverdueTasks</h3>
                <p class="text-sm text-red-100 font-medium mt-2">Needs attention</p>
            </div>
        </div>
    </div>

    <!-- VIEW TOGGLE -->
    <div class="flex gap-2 p-2 bg-white rounded-xl shadow-sm mb-6 max-w-md">
        <button id="teamsTrackBtn" onclick="switchTrackView('teams')" class="flex-1 py-3 bg-brand text-sidebar text-base font-bold rounded-lg shadow-sm transition-all flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            Teams Tracking
        </button>
        <button id="membersTrackBtn" onclick="switchTrackView('members')" class="flex-1 py-3 bg-white text-gray-700 text-base font-bold rounded-lg shadow-sm transition-all flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
            Members Tracking
        </button>
    </div>

    <!-- TEAMS VIEW -->
    <div id="teamsTrackView" class="space-y-5">
        @if (Model.Teams.Count == 0)
        {
            <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-16 text-center">
                <h3 class="text-2xl font-bold text-gray-900 mb-2">No teams to track yet</h3>
                <p class="text-gray-500">Create teams and assign tasks to see their performance.</p>
            </div>
        }

        @foreach (var team in Model.Teams)
        {
            var gradient = TeamGradient(team.Color);
            var border = TeamBorder(team.Color);

            <div class="bg-white rounded-2xl shadow-xl border-2 @border overflow-hidden">
                <div class="bg-gradient-to-r @gradient px-6 py-5">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                        <div class="flex items-center gap-4">
                            <div class="relative">
                                <div class="w-16 h-16 rounded-xl bg-white/25 backdrop-blur-sm flex items-center justify-center text-white font-black text-2xl shadow-lg">
                                    @(team.Name.Length > 0 ? team.Name.Substring(0, 1).ToUpper() : "?")
                                </div>
                                @if (!string.IsNullOrEmpty(team.RankMedal))
                                {
                                    <span class="absolute -top-2 -left-2 w-8 h-8 rounded-full bg-yellow-400 border-2 border-white flex items-center justify-center text-sm shadow-lg">@team.RankMedal</span>
                                }
                            </div>
                            <div>
                                <h2 class="text-2xl font-black text-white drop-shadow">@team.Name</h2>
                                <p class="text-base text-white/90 font-semibold mt-0.5">
                                    @team.MemberCount member@(team.MemberCount != 1 ? "s" : "") • @team.ProjectCount project@(team.ProjectCount != 1 ? "s" : "")
                                </p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-sm font-bold text-white/80 uppercase tracking-wide">Completion Rate</p>
                            <p class="text-4xl font-black text-white">@team.CompletionRate%</p>
                        </div>
                    </div>
                    <div class="mt-4 w-full h-3 bg-white/30 rounded-full overflow-hidden">
                        <div class="h-full bg-white rounded-full shadow" style="width: @(team.CompletionRate)%;"></div>
                    </div>
                </div>

                <div class="grid grid-cols-3 divide-x divide-gray-100 border-b border-gray-100">
                    <div class="p-5 text-center bg-emerald-50/50">
                        <div class="flex items-center justify-center gap-2 mb-2">
                            <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
                            <p class="text-sm font-bold text-emerald-700 uppercase tracking-wide">Completed</p>
                        </div>
                        <p class="text-4xl font-black text-emerald-600">@team.CompletedTasks</p>
                        <p class="text-xs text-gray-500 font-medium mt-1">tasks finished</p>
                    </div>
                    <div class="p-5 text-center bg-amber-50/50">
                        <div class="flex items-center justify-center gap-2 mb-2">
                            <span class="w-3 h-3 rounded-full bg-amber-500"></span>
                            <p class="text-sm font-bold text-amber-700 uppercase tracking-wide">Pending</p>
                        </div>
                        <p class="text-4xl font-black text-amber-600">@team.PendingTasks</p>
                        <p class="text-xs text-gray-500 font-medium mt-1">in progress</p>
                    </div>
                    <div class="p-5 text-center bg-red-50/50">
                        <div class="flex items-center justify-center gap-2 mb-2">
                            <span class="w-3 h-3 rounded-full bg-red-500"></span>
                            <p class="text-sm font-bold text-red-700 uppercase tracking-wide">Overdue</p>
                        </div>
                        <p class="text-4xl font-black text-red-600">@team.OverdueTasks</p>
                        <p class="text-xs text-gray-500 font-medium mt-1">past deadline</p>
                    </div>
                </div>

                <div class="p-5">
                    <h4 class="text-sm font-bold text-gray-500 uppercase tracking-wide mb-3">Projects Assigned</h4>
                    @if (team.Projects.Count == 0)
                    {
                        <p class="text-sm text-gray-400 italic">No tasks assigned yet.</p>
                    }
                    else
                    {
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            @foreach (var p in team.Projects)
                            {
                                var barColor = p.CompletionRate >= 70 ? "border-emerald-500"
                                : p.CompletionRate >= 40 ? "border-amber-500"
                                : "border-red-500";
                                var badgeColor = p.CompletionRate >= 70 ? "bg-emerald-100 text-emerald-700"
                                : p.CompletionRate >= 40 ? "bg-amber-100 text-amber-700"
                                : "bg-red-100 text-red-700";

                                <div class="bg-gray-50 rounded-lg border-l-4 @barColor p-3 flex items-center justify-between">
                                    <div>
                                        <p class="text-sm font-bold text-gray-900">@p.Name</p>
                                        <p class="text-xs text-gray-500">
                                            Completed: @p.Completed • Pending: @p.Pending
                                            @if (p.Overdue > 0)
                                            {
                                                <text> • Overdue: @p.Overdue</text>
                                            }
                                        </p>
                                    </div>
                                    <span class="px-2.5 py-1 @badgeColor text-xs font-black rounded-full">@p.CompletionRate%</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- MEMBERS VIEW -->
    <div id="membersTrackView" class="space-y-4" style="display: none;">
        @if (Model.Members.Count == 0)
        {
            <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-16 text-center">
                <h3 class="text-2xl font-bold text-gray-900 mb-2">No member activity yet</h3>
                <p class="text-gray-500">Assign tasks to members to see their performance.</p>
            </div>
        }

        @foreach (var m in Model.Members)
        {
            var avatar = string.IsNullOrEmpty(m.ProfilePictureUrl)
            ? $"https://i.pravatar.cc/150?u={m.Id}"
            : m.ProfilePictureUrl;

            var borderColor = m.CompletionRate >= 70 ? "border-emerald-400"
            : m.CompletionRate >= 40 ? "border-amber-400"
            : "border-purple-400";

            <div class="bg-white rounded-2xl shadow-xl border-2 @borderColor overflow-hidden">
                <div class="bg-gradient-to-r from-gray-700 to-gray-900 px-6 py-5">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                        <div class="flex items-center gap-4">
                            <div class="relative">
                                <img class="w-16 h-16 rounded-full border-4 border-white shadow-lg object-cover" src="@avatar" alt="">
                                @if (!string.IsNullOrEmpty(m.RankMedal))
                                {
                                    <span class="absolute -top-2 -left-2 w-8 h-8 rounded-full bg-yellow-400 border-2 border-white flex items-center justify-center text-sm shadow-lg">@m.RankMedal</span>
                                }
                            </div>
                            <div>
                                <h2 class="text-2xl font-black text-white drop-shadow">@m.FullName</h2>
                                <p class="text-base text-gray-300 font-semibold mt-0.5">@m.Role • @m.ProjectCount project@(m.ProjectCount != 1 ? "s" : "")</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="text-sm font-bold text-gray-300 uppercase tracking-wide">Completion Rate</p>
                            <p class="text-4xl font-black text-white">@m.CompletionRate%</p>
                        </div>
                    </div>
                    <div class="mt-4 w-full h-3 bg-white/30 rounded-full overflow-hidden">
                        <div class="h-full bg-white rounded-full shadow" style="width: @(m.CompletionRate)%;"></div>
                    </div>
                </div>

                <div class="grid grid-cols-3 divide-x divide-gray-100 border-b border-gray-100">
                    <div class="p-5 text-center bg-emerald-50/50">
                        <div class="flex items-center justify-center gap-2 mb-2">
                            <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
                            <p class="text-sm font-bold text-emerald-700 uppercase tracking-wide">Completed</p>
                        </div>
                        <p class="text-4xl font-black text-emerald-600">@m.CompletedTasks</p>
                        <p class="text-xs text-gray-500 font-medium mt-1">tasks finished</p>
                    </div>
                    <div class="p-5 text-center bg-amber-50/50">
                        <div class="flex items-center justify-center gap-2 mb-2">
                            <span class="w-3 h-3 rounded-full bg-amber-500"></span>
                            <p class="text-sm font-bold text-amber-700 uppercase tracking-wide">Pending</p>
                        </div>
                        <p class="text-4xl font-black text-amber-600">@m.PendingTasks</p>
                        <p class="text-xs text-gray-500 font-medium mt-1">in progress</p>
                    </div>
                    <div class="p-5 text-center bg-red-50/50">
                        <div class="flex items-center justify-center gap-2 mb-2">
                            <span class="w-3 h-3 rounded-full bg-red-500"></span>
                            <p class="text-sm font-bold text-red-700 uppercase tracking-wide">Overdue</p>
                        </div>
                        <p class="text-4xl font-black text-red-600">@m.OverdueTasks</p>
                        <p class="text-xs text-gray-500 font-medium mt-1">past deadline</p>
                    </div>
                </div>

                <div class="p-5">
                    <h4 class="text-sm font-bold text-gray-500 uppercase tracking-wide mb-3">Projects Working On</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        @foreach (var p in m.Projects)
                        {
                            var barColor = p.CompletionRate >= 70 ? "border-emerald-500"
                            : p.CompletionRate >= 40 ? "border-amber-500"
                            : "border-red-500";

                            <div class="bg-gray-50 rounded-lg border-l-4 @barColor p-3">
                                <p class="text-sm font-bold text-gray-900">@p.Name</p>
                                <p class="text-xs text-gray-500 mt-1">
                                    ✓ @p.Completed done
                                    @if (p.Pending > 0)
                                    {
                                        <text> • ⏳ @p.Pending pending</text>
                                    }
                                    @if (p.Overdue > 0)
                                    {
                                        <text> • ⚠ @p.Overdue overdue</text>
                                    }
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Legend -->
    <div class="mt-8 bg-white rounded-xl shadow-md border border-gray-100 p-5">
        <h3 class="text-sm font-bold text-gray-500 uppercase tracking-wide mb-3">Legend</h3>
        <div class="flex flex-wrap gap-5">
            <div class="flex items-center gap-2">
                <span class="w-4 h-4 rounded-full bg-emerald-500"></span>
                <span class="text-sm font-semibold text-gray-700">Completed</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="w-4 h-4 rounded-full bg-amber-500"></span>
                <span class="text-sm font-semibold text-gray-700">Pending</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="w-4 h-4 rounded-full bg-red-500"></span>
                <span class="text-sm font-semibold text-gray-700">Overdue</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="w-6 h-6 text-lg">🥇</span>
                <span class="text-sm font-semibold text-gray-700">Top Performer</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function switchTrackView(view) {
            const teamsView   = document.getElementById('teamsTrackView');
            const membersView = document.getElementById('membersTrackView');
            const teamsBtn    = document.getElementById('teamsTrackBtn');
            const membersBtn  = document.getElementById('membersTrackBtn');

            if (view === 'teams') {
                teamsView.style.display = 'block';
                membersView.style.display = 'none';
                teamsBtn.className   = 'flex-1 py-3 bg-brand text-sidebar text-base font-bold rounded-lg shadow-sm transition-all flex items-center justify-center gap-2';
                membersBtn.className = 'flex-1 py-3 bg-white text-gray-700 text-base font-bold rounded-lg shadow-sm transition-all flex items-center justify-center gap-2';
            } else {
                teamsView.style.display = 'none';
                membersView.style.display = 'block';
                teamsBtn.className   = 'flex-1 py-3 bg-white text-gray-700 text-base font-bold rounded-lg shadow-sm transition-all flex items-center justify-center gap-2';
                membersBtn.className = 'flex-1 py-3 bg-brand text-sidebar text-base font-bold rounded-lg shadow-sm transition-all flex items-center justify-center gap-2';
            }
        }
    </script>
}