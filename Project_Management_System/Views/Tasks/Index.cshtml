@using AppTaskStatus = Project_Management_System.Models.TaskStatus
@model Project_Management_System.ViewModels.TasksIndexViewModel
@{
    ViewData["Title"] = "My Tasks";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var role = Model.CurrentRole;
    var isMember = Model.IsMember;
}

<div class="bg-gray-100 min-h-screen p-6">

    @Html.AntiForgeryToken()

    <!-- Page Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
        <div>
            <h1 class="text-4xl font-bold text-gray-900 flex items-center gap-3">
                <svg class="w-10 h-10 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
                My Tasks
            </h1>
            <p class="text-lg text-gray-600 mt-2 font-medium">All your tasks organized by project.</p>
        </div>
        @if (Model.CanCreate)
        {
            <button onclick="openAddTaskModal()" class="px-6 py-3 bg-brand text-sidebar text-base font-bold rounded-lg hover:bg-yellow-400 transition-colors shadow-glow flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path></svg>
                Add Task
            </button>
        }
    </div>

    @if (!Model.Projects.Any())
    {
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-16 text-center">
            <h3 class="text-2xl font-bold text-gray-900 mb-2">No tasks yet</h3>
            <p class="text-gray-500">Create a project and add tasks to get started.</p>
        </div>
    }
    else
    {
        <div class="space-y-6">
            @foreach (var proj in Model.Projects)
            {
                var projBorder = proj.ProjectStatus switch
                {
                    ProjectStatus.Active => "from-emerald-500 via-emerald-400 to-teal-400",
                    ProjectStatus.AtRisk => "from-amber-500 via-orange-500 to-orange-400",
                    ProjectStatus.Completed => "from-blue-500 via-blue-500 to-indigo-500",
                    ProjectStatus.Done => "from-purple-500 via-purple-500 to-indigo-500",
                    _ => "from-gray-500 via-gray-400 to-gray-500"
                };

                <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
                    <div class="bg-gradient-to-r @projBorder px-6 py-5 cursor-pointer relative overflow-hidden"
                         onclick="toggleProject('@proj.ProjectId')">
                        <div class="relative flex items-center justify-between">
                            <div class="flex items-center gap-4">
                                <div class="w-14 h-14 rounded-xl bg-white/20 backdrop-blur-sm flex items-center justify-center text-white font-black text-lg shadow-lg">
                                    @proj.ProjectInitials
                                </div>
                                <div>
                                    <h2 class="text-2xl font-black text-white drop-shadow">@proj.ProjectName</h2>
                                    <p class="text-base text-white/90 font-semibold mt-0.5">
                                        @(proj.ProjectClient ?? "—") • @proj.Tasks.Count task@(proj.Tasks.Count != 1 ? "s" : "")
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center gap-4">
                                <span class="hidden md:inline-block px-3 py-1 text-sm font-black bg-white/25 backdrop-blur-sm text-white rounded-full uppercase">
                                    @proj.ProjectStatus
                                </span>
                                <svg id="chevron-@proj.ProjectId" class="w-6 h-6 text-white transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <div id="@proj.ProjectId" class="p-6 space-y-5 bg-gradient-to-b from-gray-50 to-white">

                        @if (!proj.Tasks.Any())
                        {
                            <div class="text-center py-8">
                                <p class="text-sm text-gray-400 italic">No tasks in this project yet.</p>
                            </div>
                        }

                        @foreach (var t in proj.Tasks)
                        {
                            var prioClass = t.Priority switch
                            {
                                TaskPriority.Critical => "bg-red-100 text-red-700",
                                TaskPriority.High => "bg-red-100 text-red-700",
                                TaskPriority.Medium => "bg-amber-100 text-amber-700",
                                _ => "bg-green-100 text-green-700"
                            };
                            var borderClass = t.Priority switch
                            {
                                TaskPriority.Critical => "border-l-red-600",
                                TaskPriority.High => "border-l-red-500",
                                TaskPriority.Medium => "border-l-amber-500",
                                _ => "border-l-green-500"
                            };
                            @* var statusClass = t.Status switch
                            {
                                AppTaskStatus.Completed => "bg-emerald-100 text-emerald-700",
                                AppTaskStatus.Done => "bg-blue-100 text-blue-700",
                                AppTaskStatus.InProgress => "bg-amber-100 text-amber-700",
                                AppTaskStatus.Planning => "bg-purple-100 text-purple-700",
                                _ => "bg-gray-100 text-gray-700"
                            }; *@

                            var statusClass = t.Status switch
                            {
                                AppTaskStatus.Completed => "bg-emerald-100 text-emerald-700",
                                AppTaskStatus.Done => "bg-blue-100 text-blue-700",
                                AppTaskStatus.InProgress => "bg-amber-100 text-amber-700",
                                AppTaskStatus.Planning => "bg-purple-100 text-purple-700",
                                _ => "bg-gray-100 text-gray-700"
                            };

                            <div class="bg-white rounded-xl shadow-md border border-gray-200 border-l-4 @borderClass p-6 cursor-pointer hover:shadow-xl transition-all"
                                 onclick="openTaskDetailsById('@t.Id')">

                                <div class="flex justify-between items-start mb-4">
                                    <div class="flex items-center gap-3 flex-wrap">
                                        <span class="px-3 py-1.5 text-sm font-black @prioClass rounded-full tracking-wide">@t.Priority.ToString().ToUpper()</span>
                                        <span class="px-3 py-1.5 text-sm font-bold @statusClass rounded-full">@t.Status</span>
                                        @if (t.IsOverdue)
                                        {
                                            <span class="px-3 py-1.5 text-sm font-bold bg-red-100 text-red-700 rounded-full">⚠ Overdue</span>
                                        }
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm text-gray-400 font-bold">#@t.Id.ToString().Substring(0, 6).ToUpper()</span>
                                        <div class="relative">
                                            <button onclick="toggleTaskMenu(event, 'taskMenu-@t.Id')" class="text-gray-400 hover:text-gray-700 p-1.5 rounded-full hover:bg-gray-100 transition-colors">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path></svg>
                                            </button>
                                            <div id="taskMenu-@t.Id" class="hidden absolute right-0 mt-1 w-56 bg-white rounded-lg shadow-2xl border border-gray-100 z-30 py-1">
                                                <div class="px-3 py-2 text-xs font-bold text-gray-400 uppercase tracking-wider">Change Status</div>
                                                <a href="#" onclick="changeTaskStatus(event, '@t.Id', 'Planning')" class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-purple-50"><span class="w-2 h-2 rounded-full bg-purple-400"></span> Planning</a>
                                                <a href="#" onclick="changeTaskStatus(event, '@t.Id', 'ToDo')" class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50"><span class="w-2 h-2 rounded-full bg-gray-400"></span> To Do</a>
                                                <a href="#" onclick="changeTaskStatus(event, '@t.Id', 'InProgress')" class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-amber-50"><span class="w-2 h-2 rounded-full bg-amber-500"></span> In Progress</a>
                                                <a href="#" onclick="changeTaskStatus(event, '@t.Id', 'Done')" class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-blue-50"><span class="w-2 h-2 rounded-full bg-blue-500"></span> Done</a>

                                                @if (!isMember)
                                                {
                                                    <a href="#" onclick="changeTaskStatus(event, '@t.Id', 'Completed')" class="flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-emerald-50"><span class="w-2 h-2 rounded-full bg-emerald-500"></span> Completed</a>
                                                    <div class="border-t border-gray-100 my-1"></div>
                                                    <a href="#" onclick="deleteTask(event, '@t.Id')" class="flex items-center gap-2 px-4 py-2 text-sm text-red-600 font-semibold hover:bg-red-50">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                                        Delete Task
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <h3 class="text-2xl font-bold text-gray-900 mb-2">@t.Title</h3>
                                <p class="text-base text-gray-600 mb-5 leading-relaxed">@(t.Description ?? "No description.")</p>

                                <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrEmpty(t.AssigneeName))
                                        {
                                            <img class="w-9 h-9 rounded-full border-2 border-white shadow-md object-cover"
                                                 src="@(string.IsNullOrEmpty(t.AssigneePicture) ? $"https://i.pravatar.cc/100?u={t.AssigneeId}" : t.AssigneePicture)" alt="">
                                            <span class="text-base text-gray-700 font-semibold">@t.AssigneeName</span>
                                        }
                                        else
                                        {
                                            <span class="text-sm text-gray-400 italic">Unassigned</span>
                                        }
                                    </div>
                                    <div class="flex items-center gap-4 text-xs text-gray-500 font-semibold">
                                        <span>📅 @(t.StartDate?.ToString("MMM dd") ?? "—") → @(t.Deadline?.ToString("MMM dd, yyyy") ?? "—")</span>
                                        <span>📋 @t.SubtaskDone/@t.SubtaskCount</span>
                                        <span>⚠ @t.ChallengeCount</span>
                                    </div>
                                </div>

                                <div class="grid grid-cols-3 gap-3 pt-4 border-t border-gray-100">
                                    <button onclick="openTaskWorkModalById(event, '@t.Id')"
                                            class="py-3 bg-gradient-to-br from-purple-500 to-purple-600 text-white text-sm font-bold rounded-lg hover:shadow-lg transform hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3"></path></svg>
                                        Work
                                    </button>
                                    <button onclick="openChallengeModalById(event, '@t.Id')"
                                            class="relative py-3 bg-gradient-to-br from-amber-500 to-orange-500 text-white text-sm font-bold rounded-lg hover:shadow-lg transform hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2">
                                        @if (t.ChallengeCount > 0)
                                        {
                                            <span class="absolute -top-2 -right-2 bg-red-600 text-white text-xs font-black rounded-full w-6 h-6 flex items-center justify-center shadow-lg ring-2 ring-white">@t.ChallengeCount</span>
                                        }
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                                        Challenges
                                    </button>
                                    <button onclick="openGuideModalById(event, '@t.Id')"
                                            class="py-3 bg-gradient-to-br from-blue-500 to-blue-600 text-white text-sm font-bold rounded-lg hover:shadow-lg transform hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                                        Guide
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ============================================= -->
<!-- MODAL 1: TASK DETAILS                         -->
<!-- ============================================= -->
<div id="taskDetailsModal" class="fixed inset-0 z-50 hidden bg-gray-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-xl overflow-hidden max-h-[90vh] flex flex-col">
        <div class="bg-gradient-to-r from-gray-800 to-gray-900 px-6 py-5 flex justify-between items-center">
            <h3 class="text-xl font-bold text-white" id="detailsTitle">Task Details</h3>
            <button onclick="closeModal('taskDetailsModal')" class="text-white/80 hover:text-white p-1 rounded-full hover:bg-white/20">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div class="p-6 space-y-4 overflow-y-auto">
            <div class="flex flex-wrap gap-2 pb-3 border-b border-gray-100">
                <span id="detailsStatus" class="px-3 py-1 text-sm font-bold rounded-full">—</span>
                <span id="detailsPriority" class="px-3 py-1 text-sm font-bold rounded-full">—</span>
            </div>
            <div class="grid grid-cols-2 gap-4 pb-3 border-b border-gray-100">
                <div>
                    <p class="text-xs font-black text-emerald-500 uppercase tracking-wide mb-1">Assignee</p>
                    <p class="text-base font-bold text-gray-900" id="detailsAssignee">—</p>
                </div>
                <div>
                    <p class="text-xs font-black text-emerald-500 uppercase tracking-wide mb-1">Timeline</p>
                    <p class="text-base font-bold text-gray-900" id="detailsTimeline">—</p>
                </div>
            </div>
            <div>
                <p class="text-sm font-black text-emerald-500 uppercase tracking-wide mb-1">Description</p>
                <p class="text-base text-gray-700 leading-relaxed" id="detailsDesc">—</p>
            </div>
            <div id="detailsObjectivesSection">
                <p class="text-sm font-black text-emerald-500 uppercase tracking-wide mb-1">Objectives</p>
                <p class="text-base text-gray-700 leading-relaxed" id="detailsObjectives">—</p>
            </div>
            <div id="detailsInstructionsSection">
                <p class="text-sm font-black text-emerald-500 uppercase tracking-wide mb-1">Instructions</p>
                <p class="text-base text-gray-700 leading-relaxed" id="detailsInstructionsText">—</p>
            </div>
        </div>
        <div class="bg-gray-50 px-6 py-4 flex justify-end gap-3 border-t border-gray-100">
            <button onclick="closeModal('taskDetailsModal')" class="px-5 py-2.5 border border-gray-300 rounded-lg font-semibold text-gray-700">Close</button>
        </div>
    </div>
</div>

<!-- ============================================= -->
<!-- MODAL 2: CHALLENGES                           -->
<!-- ============================================= -->
<div id="challengeModal" class="fixed inset-0 z-50 hidden bg-gray-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl overflow-hidden max-h-[90vh] flex flex-col">
        <div class="bg-gradient-to-r from-amber-500 to-orange-500 px-6 py-5 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center text-white">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-white">Challenges</h3>
                    <p class="text-sm text-amber-50" id="challengeTaskName">Task Name</p>
                </div>
            </div>
            <button onclick="closeModal('challengeModal')" class="text-white/80 hover:text-white p-1 rounded-full hover:bg-white/20">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div class="p-6 overflow-y-auto flex-1">
            <!-- Add new challenge -->
            <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-5">
                <h4 class="text-sm font-bold text-amber-900 mb-3 flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    Raise New Challenge
                </h4>
                <div class="space-y-3">
                    <input type="text" id="challengeTitle" placeholder="Challenge title (e.g. Requirements unclear)" class="w-full bg-white border border-gray-300 text-gray-900 text-sm rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-amber-500">
                    <textarea id="challengeDescription" rows="2" placeholder="Explain the challenge in detail..." class="w-full bg-white border border-gray-300 text-gray-900 text-sm rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-amber-500 resize-none"></textarea>
                    <div class="flex justify-end">
                        <button onclick="submitChallenge()" class="px-4 py-2 bg-amber-600 text-white text-sm font-semibold rounded-lg hover:bg-amber-700 transition-colors">Add Challenge</button>
                    </div>
                </div>
            </div>

            <h4 class="text-sm font-bold text-gray-700 uppercase tracking-wider mb-3">
                Active Challenges (<span id="challengeCount">0</span>)
            </h4>
            <div id="challengeList" class="space-y-3">
                <p class="text-sm text-gray-400 italic text-center py-4">Loading challenges...</p>
            </div>
        </div>
        <div class="bg-gray-50 px-6 py-4 flex justify-end gap-3 border-t border-gray-100">
            <button onclick="closeModal('challengeModal')" class="px-5 py-2.5 border border-gray-300 rounded-lg font-semibold text-gray-700">Close</button>
        </div>
    </div>
</div>

<!-- ============================================= -->
<!-- MODAL 3: GUIDE                                 -->
<!-- ============================================= -->
<div id="guideModal" class="fixed inset-0 z-50 hidden bg-gray-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-xl overflow-hidden max-h-[90vh] flex flex-col">
        <div class="bg-gradient-to-r from-blue-500 to-indigo-600 px-6 py-5 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center text-white">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-white">Task Guide</h3>
                    <p class="text-sm text-blue-100" id="guideTaskName">Task Name</p>
                </div>
            </div>
            <button onclick="closeModal('guideModal')" class="text-white/80 hover:text-white p-1 rounded-full hover:bg-white/20">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div class="p-6 overflow-y-auto flex-1 space-y-5">
            <div>
                <h4 class="text-sm font-bold text-gray-700 uppercase tracking-wider mb-2">📋 Instructions</h4>
                <div class="bg-gray-50 rounded-lg p-4 border border-gray-100">
                    <p class="text-base text-gray-700 leading-relaxed whitespace-pre-wrap" id="guideInstructionsText">
                        No instructions provided.
                    </p>
                </div>
            </div>
            <div id="guideFileSection" class="hidden">
                <h4 class="text-sm font-bold text-gray-700 uppercase tracking-wider mb-2">📎 Attached File</h4>
                <a id="guideFileLink" href="#" target="_blank"
                   class="flex items-center justify-between p-3 bg-white border border-gray-200 rounded-lg hover:bg-blue-50 hover:border-blue-300 transition-colors group">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-red-50 flex items-center justify-center text-red-600">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                        </div>
                        <div>
                            <p class="text-sm font-bold text-gray-900">Instructions File</p>
                            <p class="text-xs text-gray-500 truncate max-w-xs" id="guideFileName">view-file</p>
                        </div>
                    </div>
                    <svg class="w-5 h-5 text-gray-400 group-hover:text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                </a>
            </div>
        </div>
        <div class="bg-gray-50 px-6 py-4 flex justify-end gap-3 border-t border-gray-100">
            <button onclick="closeModal('guideModal')" class="px-5 py-2.5 border border-gray-300 rounded-lg font-semibold text-gray-700">Close</button>
        </div>
    </div>
</div>

<!-- ============================================= -->
<!-- MODAL 4: TASK WORK BREAKDOWN                   -->
<!-- ============================================= -->
<div id="taskWorkModal" class="fixed inset-0 z-50 hidden bg-gray-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl overflow-hidden max-h-[90vh] flex flex-col">
        <div class="bg-gradient-to-r from-purple-500 to-purple-600 px-6 py-5 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center text-white">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3"></path></svg>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-white">Task Work Breakdown</h3>
                    <p class="text-sm text-purple-100" id="taskWorkName">Task Name</p>
                </div>
            </div>
            <button onclick="closeModal('taskWorkModal')" class="text-white/80 hover:text-white p-1 rounded-full hover:bg-white/20">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div class="p-6 overflow-y-auto flex-1">
            <div class="mb-5">
                <div class="flex justify-between text-sm mb-2">
                    <span class="text-gray-600 font-semibold">Overall Progress</span>
                    <span class="text-gray-900 font-bold"><span id="subtaskDoneCount">0</span>/<span id="subtaskTotalCount">0</span> done</span>
                </div>
                <div class="w-full h-2.5 bg-gray-100 rounded-full overflow-hidden">
                    <div id="subtaskProgressBar" class="bg-gradient-to-r from-purple-500 to-purple-600 h-full rounded-full" style="width: 0%;"></div>
                </div>
            </div>

            <h4 class="text-sm font-bold text-gray-700 uppercase tracking-wider mb-3">Subtasks</h4>
            <div id="subtaskList" class="space-y-3 mb-4">
                <p class="text-sm text-gray-400 italic text-center py-4">Loading subtasks...</p>
            </div>

            <!-- Add subtask -->
            <div class="border-t border-gray-100 pt-4">
                <button onclick="toggleAddSubtask()" id="addSubtaskBtn" class="w-full py-2.5 border-2 border-dashed border-purple-300 text-purple-600 text-sm font-bold rounded-lg hover:bg-purple-50 transition-colors flex items-center justify-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path></svg>
                    Add Subtask
                </button>
                <div id="addSubtaskForm" class="hidden mt-3 p-4 bg-gray-50 rounded-lg space-y-3">
                    <input type="text" id="newSubtaskTitle" placeholder="Subtask title *" class="w-full bg-white border border-gray-300 text-gray-900 text-sm rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500">
                    <textarea id="newSubtaskDesc" rows="2" placeholder="Description (optional)" class="w-full bg-white border border-gray-300 text-gray-900 text-sm rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 resize-none"></textarea>
                    <div class="flex justify-end gap-2">
                        <button onclick="toggleAddSubtask()" class="px-4 py-2 text-sm font-semibold text-gray-600 hover:text-gray-800">Cancel</button>
                        <button onclick="saveSubtask()" class="px-4 py-2 bg-purple-600 text-white text-sm font-bold rounded-lg hover:bg-purple-700">Add</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="bg-gray-50 px-6 py-4 flex justify-end gap-3 border-t border-gray-100">
            <button onclick="closeModal('taskWorkModal')" class="px-5 py-2.5 border border-gray-300 rounded-lg font-semibold text-gray-700">Close</button>
        </div>
    </div>
</div>

<!-- ============================================= -->
<!-- ADD TASK MODAL                                -->
<!-- ============================================= -->
<div id="addTaskModal" class="fixed inset-0 z-50 hidden bg-gray-900/60 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl overflow-hidden max-h-[90vh] flex flex-col">
        <div class="bg-gradient-to-r from-blue-500 to-indigo-600 px-6 py-5 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center text-white">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"></path></svg>
                </div>
                <h3 class="text-xl font-bold text-white">Add New Task</h3>
            </div>
            <button onclick="closeModal('addTaskModal')" class="text-white/80 hover:text-white p-1 rounded-full hover:bg-white/20">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <form id="addTaskForm" class="p-6 space-y-4 overflow-y-auto" onsubmit="event.preventDefault(); createTask();">

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1.5">Project *</label>
                <select id="taskProject" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand/60 outline-none">
                    <option value="">Select project...</option>
                    @foreach (var p in Model.Projects)
                    {
                        <option value="@p.ProjectId">@p.ProjectName</option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1.5">Task Title *</label>
                <input type="text" id="taskTitle" required placeholder="e.g. Review drawings" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand/60 outline-none">
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1.5">Description</label>
                <textarea id="taskDescription" rows="2" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand/60 outline-none resize-none"></textarea>
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1.5">Objectives</label>
                <textarea id="taskObjectives" rows="2" placeholder="What should this task achieve?" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand/60 outline-none resize-none"></textarea>
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1.5">Instructions (Text)</label>
                <textarea id="taskInstructions" rows="3" placeholder="Detailed step-by-step instructions..." class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand/60 outline-none resize-none"></textarea>
            </div>

            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1.5">Instructions File URL (PDF, optional)</label>
                <input type="url" id="taskInstructionsFile" placeholder="https://..." class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand/60 outline-none">
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Start Date</label>
                    <input type="date" id="taskStartDate" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand/60 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Deadline</label>
                    <input type="date" id="taskDeadline" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand/60 outline-none">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Priority</label>
                    <select id="taskPriority" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand/60 outline-none">
                        <option value="Low">Low</option>
                        <option value="Medium" selected>Medium</option>
                        <option value="High">High</option>
                        <option value="Critical">Critical</option>
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Assign To (Member)</label>
                    <select id="taskAssignee" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand/60 outline-none">
                        <option value="">Unassigned</option>
                        @foreach (var m in Model.Members)
                        {
                            <option value="@m.Id">@m.FullName (@m.Email)</option>
                        }
                    </select>
                </div>
            </div>

            <div id="addTaskError" class="hidden p-3 bg-red-50 border border-red-200 rounded-lg">
                <p class="text-sm font-semibold text-red-700" id="addTaskErrorText"></p>
            </div>
        </form>
        <div class="bg-gray-50 px-6 py-4 flex justify-end gap-3 border-t border-gray-100">
            <button onclick="closeModal('addTaskModal')" class="px-5 py-2.5 border border-gray-300 rounded-lg font-semibold text-gray-700">Cancel</button>
            <button id="btnCreateTask" onclick="createTask()" class="px-6 py-2.5 bg-brand text-sidebar rounded-lg font-bold hover:bg-yellow-400">Create Task</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ============================================
        // STATE
        // ============================================
        let currentTaskId = null;
        let currentTaskName = '';

        function getToken() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        // ============================================
        // MODAL HELPERS
        // ============================================
        function openModal(id) { const el = document.getElementById(id); if (el) { el.classList.remove('hidden'); el.classList.add('flex'); } }
        function closeModal(id) { const el = document.getElementById(id); if (el) { el.classList.add('hidden'); el.classList.remove('flex'); } }

        function showToast(message, type = 'success') {
            const bg = type === 'success' ? 'bg-emerald-500' : 'bg-red-500';
            const toast = document.createElement('div');
            toast.className = `fixed top-6 right-6 z-[60] ${bg} text-white px-6 py-4 rounded-xl shadow-2xl font-semibold text-base transition-all duration-300`;
            toast.innerText = message;
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        // ============================================
        // TOGGLE PROJECT COLLAPSE
        // ============================================
        function toggleProject(projectId) {
            const content = document.getElementById(projectId);
            const chevron = document.getElementById('chevron-' + projectId);
            if (!content) return;
            if (content.style.display === 'none') {
                content.style.display = 'block';
                if (chevron) chevron.style.transform = 'rotate(0deg)';
            } else {
                content.style.display = 'none';
                if (chevron) chevron.style.transform = 'rotate(-90deg)';
            }
        }

        // ============================================
        // TASK MENU
        // ============================================
        function toggleTaskMenu(event, menuId) {
            event.stopPropagation();
            document.querySelectorAll('[id^="taskMenu-"]').forEach(el => { if (el.id !== menuId) el.classList.add('hidden'); });
            document.getElementById(menuId).classList.toggle('hidden');
        }
        document.addEventListener('click', function () {
            document.querySelectorAll('[id^="taskMenu-"]').forEach(el => el.classList.add('hidden'));
        });

        // ============================================
        // OPEN TASK DETAILS
        // ============================================
        async function openTaskDetailsById(id) {
            try {
                const res = await fetch(`/Tasks/GetTask/${id}`);
                if (!res.ok) { showToast('Failed to load task.', 'error'); return; }
                const t = await res.json();

                document.getElementById('detailsTitle').innerText = t.title;
                document.getElementById('detailsAssignee').innerText = t.assigneeName || 'Unassigned';
                const start = t.startDate ? new Date(t.startDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '—';
                const end = t.deadline ? new Date(t.deadline).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—';
                document.getElementById('detailsTimeline').innerText = `${start} → ${end}`;
                document.getElementById('detailsDesc').innerText = t.description || 'No description.';
                document.getElementById('detailsObjectives').innerText = t.objectives || 'No objectives.';
                document.getElementById('detailsInstructionsText').innerText = t.instructionsText || 'No text instructions.';

                // Status badge
                const sEl = document.getElementById('detailsStatus');
                sEl.innerText = t.status;
                sEl.className = 'px-3 py-1 text-sm font-bold rounded-full ';
                if (t.status === 'Completed') sEl.classList.add('bg-emerald-100', 'text-emerald-700');
                else if (t.status === 'Done') sEl.classList.add('bg-blue-100', 'text-blue-700');
                else if (t.status === 'InProgress') sEl.classList.add('bg-amber-100', 'text-amber-700');
                else if (t.status === 'Planning') sEl.classList.add('bg-purple-100', 'text-purple-700');
                else sEl.classList.add('bg-gray-100', 'text-gray-700');

                // Priority badge
                const pEl = document.getElementById('detailsPriority');
                pEl.innerText = t.priority;
                pEl.className = 'px-3 py-1 text-sm font-bold rounded-full ';
                if (t.priority === 'Critical') pEl.classList.add('bg-red-100', 'text-red-700');
                else if (t.priority === 'High') pEl.classList.add('bg-orange-100', 'text-orange-700');
                else if (t.priority === 'Medium') pEl.classList.add('bg-amber-100', 'text-amber-700');
                else pEl.classList.add('bg-green-100', 'text-green-700');

                openModal('taskDetailsModal');
            } catch (err) { console.error(err); showToast('Error loading task.', 'error'); }
        }

        // ============================================
        // OPEN TASK WORK BREAKDOWN
        // ============================================
        async function openTaskWorkModalById(event, id) {
            event.stopPropagation();
            currentTaskId = id;

            const res = await fetch(`/Tasks/GetTask/${id}`);
            if (!res.ok) return;
            const t = await res.json();
            currentTaskName = t.title;

            document.getElementById('taskWorkName').innerText = t.title;
            renderSubtasks(t.subtasks || []);
            openModal('taskWorkModal');
        }

        function renderSubtasks(subtasks) {
            const list = document.getElementById('subtaskList');
            const total = subtasks.length;
            const done = subtasks.filter(s => s.status === 'Done').length;

            document.getElementById('subtaskTotalCount').innerText = total;
            document.getElementById('subtaskDoneCount').innerText = done;
            document.getElementById('subtaskProgressBar').style.width = (total ? (done / total * 100) : 0) + '%';

            if (total === 0) {
                list.innerHTML = '<p class="text-sm text-gray-400 italic text-center py-4">No subtasks yet. Add one below.</p>';
                return;
            }

            list.innerHTML = subtasks.map(s => {
                const statusClass = s.status === 'Done' ? 'bg-emerald-100 text-emerald-700 border-emerald-300'
                    : s.status === 'InProgress' ? 'bg-amber-100 text-amber-700 border-amber-300'
                    : s.status === 'ToDo' ? 'bg-gray-100 text-gray-700 border-gray-300'
                    : 'bg-purple-100 text-purple-700 border-purple-300';

                const borderCls = s.status === 'Done' ? 'border-emerald-200 bg-emerald-50/50'
                    : s.status === 'InProgress' ? 'border-amber-200 bg-amber-50/50'
                    : 'border-gray-200 bg-gray-50';

                return `
                    <div class="border ${borderCls} rounded-lg p-4">
                        <div class="flex justify-between items-start mb-2">
                            <p class="text-base font-semibold text-gray-800 flex-1 pr-3">${escapeHtml(s.title)}</p>
                            <div class="flex items-center gap-2 shrink-0">
                                <select onchange="updateSubtaskStatus('${s.id}', this.value)" class="text-xs font-bold ${statusClass} border rounded-full px-3 py-1 focus:outline-none cursor-pointer">
                                    <option value="Planning" ${s.status === 'Planning' ? 'selected' : ''}>Planning</option>
                                    <option value="ToDo" ${s.status === 'ToDo' ? 'selected' : ''}>To Do</option>
                                    <option value="InProgress" ${s.status === 'InProgress' ? 'selected' : ''}>In Progress</option>
                                    <option value="Done" ${s.status === 'Done' ? 'selected' : ''}>Done</option>
                                </select>
                                <button onclick="deleteSubtask('${s.id}')" class="text-gray-400 hover:text-red-500 p-1">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                </button>
                            </div>
                        </div>
                        ${s.description ? `<p class="text-sm text-gray-600 mt-1">${escapeHtml(s.description)}</p>` : ''}
                    </div>
                `;
            }).join('');
        }

        function toggleAddSubtask() {
            document.getElementById('addSubtaskForm').classList.toggle('hidden');
            document.getElementById('newSubtaskTitle').value = '';
            document.getElementById('newSubtaskDesc').value = '';
        }

        async function saveSubtask() {
            const title = document.getElementById('newSubtaskTitle').value.trim();
            const description = document.getElementById('newSubtaskDesc').value.trim();
            if (!title) { showToast('Subtask title is required.', 'error'); return; }
            if (!currentTaskId) return;

            const fd = new FormData();
            fd.append('taskId', currentTaskId);
            fd.append('title', title);
            fd.append('description', description);
            fd.append('__RequestVerificationToken', getToken());

            const res = await fetch('/Tasks/CreateSubtask', { method: 'POST', body: fd });
            const result = await res.json();
            if (result.success) {
                showToast('Subtask added.', 'success');
                // reload subtasks
                const res2 = await fetch(`/Tasks/GetTask/${currentTaskId}`);
                const t = await res2.json();
                renderSubtasks(t.subtasks || []);
                document.getElementById('addSubtaskForm').classList.add('hidden');
            } else {
                showToast(result.message, 'error');
            }
        }

        async function updateSubtaskStatus(id, status) {
            const fd = new FormData();
            fd.append('id', id);
            fd.append('status', status);
            fd.append('__RequestVerificationToken', getToken());
            const res = await fetch('/Tasks/UpdateSubtaskStatus', { method: 'POST', body: fd });
            const result = await res.json();
            if (result.success) {
                // Refresh the list
                const res2 = await fetch(`/Tasks/GetTask/${currentTaskId}`);
                const t = await res2.json();
                renderSubtasks(t.subtasks || []);
            } else showToast(result.message, 'error');
        }

        async function deleteSubtask(id) {
            if (!confirm('Delete this subtask?')) return;
            const fd = new FormData();
            fd.append('id', id);
            fd.append('__RequestVerificationToken', getToken());
            const res = await fetch('/Tasks/DeleteSubtask', { method: 'POST', body: fd });
            const result = await res.json();
            if (result.success) {
                const res2 = await fetch(`/Tasks/GetTask/${currentTaskId}`);
                const t = await res2.json();
                renderSubtasks(t.subtasks || []);
                showToast('Subtask removed.', 'success');
            } else showToast(result.message, 'error');
        }

        // ============================================
        // OPEN CHALLENGES
        // ============================================
        async function openChallengeModalById(event, id) {
            event.stopPropagation();
            currentTaskId = id;

            const res = await fetch(`/Tasks/GetTask/${id}`);
            if (!res.ok) return;
            const t = await res.json();

            document.getElementById('challengeTaskName').innerText = t.title;
            renderChallenges(t.challenges || []);
            openModal('challengeModal');
        }

        function renderChallenges(challenges) {
            const list = document.getElementById('challengeList');
            document.getElementById('challengeCount').innerText = challenges.length;

            if (challenges.length === 0) {
                list.innerHTML = '<p class="text-sm text-gray-400 italic text-center py-4">No challenges raised yet.</p>';
                return;
            }

            list.innerHTML = challenges.map(c => {
                const statusClass = c.status === 'Done' ? 'bg-emerald-100 text-emerald-700 border-emerald-200'
                    : c.status === 'InProgress' ? 'bg-amber-100 text-amber-700 border-amber-200'
                    : 'bg-red-100 text-red-700 border-red-200';

                const avatar = c.raisedByPicture || `https://i.pravatar.cc/100?u=${c.id}`;

                return `
                    <div class="border border-gray-200 rounded-lg p-4 bg-white">
                        <div class="flex justify-between items-start mb-2">
                            <div class="flex items-center gap-2">
                                <img class="w-7 h-7 rounded-full object-cover" src="${avatar}" alt="">
                                <div>
                                    <p class="text-sm font-semibold text-gray-900">${escapeHtml(c.raisedByName || 'User')}</p>
                                    <p class="text-xs text-gray-500">Raised ${escapeHtml(c.createdAt)}</p>
                                </div>
                            </div>
                            <select onchange="updateChallengeStatus('${c.id}', this.value)" class="text-xs font-semibold ${statusClass} border rounded-full px-3 py-1 focus:outline-none cursor-pointer">
                                <option value="ToDo" ${c.status === 'ToDo' ? 'selected' : ''}>To Do</option>
                                <option value="InProgress" ${c.status === 'InProgress' ? 'selected' : ''}>In Progress</option>
                                <option value="Done" ${c.status === 'Done' ? 'selected' : ''}>Done</option>
                            </select>
                        </div>
                        <p class="text-sm font-semibold text-gray-700 mt-2">${escapeHtml(c.title)}</p>
                        ${c.description ? `<p class="text-sm text-gray-600 mt-1">${escapeHtml(c.description)}</p>` : ''}
                    </div>
                `;
            }).join('');
        }

        async function submitChallenge() {
            const title = document.getElementById('challengeTitle').value.trim();
            const description = document.getElementById('challengeDescription').value.trim();
            if (!title) { showToast('Challenge title is required.', 'error'); return; }
            if (!currentTaskId) return;

            const fd = new FormData();
            fd.append('taskId', currentTaskId);
            fd.append('title', title);
            fd.append('description', description);
            fd.append('__RequestVerificationToken', getToken());

            const res = await fetch('/Tasks/CreateChallenge', { method: 'POST', body: fd });
            const result = await res.json();
            if (result.success) {
                document.getElementById('challengeTitle').value = '';
                document.getElementById('challengeDescription').value = '';

                const res2 = await fetch(`/Tasks/GetTask/${currentTaskId}`);
                const t = await res2.json();
                renderChallenges(t.challenges || []);
                showToast('Challenge raised.', 'success');
            } else showToast(result.message, 'error');
        }

        async function updateChallengeStatus(id, status) {
            const fd = new FormData();
            fd.append('id', id);
            fd.append('status', status);
            fd.append('__RequestVerificationToken', getToken());
            const res = await fetch('/Tasks/UpdateChallengeStatus', { method: 'POST', body: fd });
            const result = await res.json();
            if (result.success) {
                const res2 = await fetch(`/Tasks/GetTask/${currentTaskId}`);
                const t = await res2.json();
                renderChallenges(t.challenges || []);
            } else showToast(result.message, 'error');
        }

        // ============================================
        // OPEN GUIDE
        // ============================================
        async function openGuideModalById(event, id) {
            event.stopPropagation();
            const res = await fetch(`/Tasks/GetTask/${id}`);
            if (!res.ok) return;
            const t = await res.json();

            document.getElementById('guideTaskName').innerText = t.title;

            const text = t.instructionsText || 'No text instructions provided for this task.';
            document.getElementById('guideInstructionsText').innerText = text;

            const fileSection = document.getElementById('guideFileSection');
            const fileLink = document.getElementById('guideFileLink');
            const fileName = document.getElementById('guideFileName');

            if (t.instructionsFileUrl) {
                fileSection.classList.remove('hidden');
                fileLink.href = t.instructionsFileUrl;
                const parts = t.instructionsFileUrl.split('/');
                fileName.innerText = parts[parts.length - 1] || 'instructions-file';
            } else {
                fileSection.classList.add('hidden');
            }

            openModal('guideModal');
        }

        // ============================================
        // CHANGE TASK STATUS
        // ============================================
        async function changeTaskStatus(event, id, status) {
            event.stopPropagation();
            event.preventDefault();
            const fd = new FormData();
            fd.append('id', id);
            fd.append('status', status);
            fd.append('__RequestVerificationToken', getToken());
            const res = await fetch('/Tasks/UpdateStatus', { method: 'POST', body: fd });
            const result = await res.json();
            if (result.success) { showToast(result.message, 'success'); setTimeout(() => location.reload(), 700); }
            else showToast(result.message, 'error');
        }

        // ============================================
        // DELETE TASK
        // ============================================
        async function deleteTask(event, id) {
            event.stopPropagation();
            event.preventDefault();
            if (!confirm('Delete this task? This cannot be undone.')) return;
            const fd = new FormData();
            fd.append('id', id);
            fd.append('__RequestVerificationToken', getToken());
            const res = await fetch('/Tasks/DeleteTask', { method: 'POST', body: fd });
            const result = await res.json();
            if (result.success) { showToast(result.message, 'success'); setTimeout(() => location.reload(), 700); }
            else showToast(result.message, 'error');
        }

        // ============================================
        // CREATE TASK
        // ============================================
        function openAddTaskModal() {
            ['taskProject', 'taskTitle', 'taskDescription', 'taskObjectives', 'taskInstructions',
             'taskInstructionsFile', 'taskStartDate', 'taskDeadline', 'taskAssignee'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.value = '';
            });
            document.getElementById('taskPriority').value = 'Medium';
            document.getElementById('addTaskError').classList.add('hidden');
            openModal('addTaskModal');
        }

        async function createTask() {
            const errEl = document.getElementById('addTaskError');
            const errText = document.getElementById('addTaskErrorText');
            errEl.classList.add('hidden');

            const projectId = document.getElementById('taskProject').value;
            const title = document.getElementById('taskTitle').value.trim();
            if (!projectId) { errText.innerText = 'Please select a project.'; errEl.classList.remove('hidden'); return; }
            if (!title) { errText.innerText = 'Task title is required.'; errEl.classList.remove('hidden'); return; }

            const fd = new FormData();
            fd.append('ProjectId', projectId);
            fd.append('Title', title);
            fd.append('Description', document.getElementById('taskDescription').value);
            fd.append('Objectives', document.getElementById('taskObjectives').value);
            fd.append('InstructionsText', document.getElementById('taskInstructions').value);
            fd.append('InstructionsFileUrl', document.getElementById('taskInstructionsFile').value);
            fd.append('StartDate', document.getElementById('taskStartDate').value);
            fd.append('Deadline', document.getElementById('taskDeadline').value);
            fd.append('Priority', document.getElementById('taskPriority').value);
            fd.append('AssigneeId', document.getElementById('taskAssignee').value);
            fd.append('__RequestVerificationToken', getToken());

            const btn = document.getElementById('btnCreateTask');
            btn.disabled = true;
            btn.innerText = 'Creating...';

            try {
                const res = await fetch('/Tasks/CreateTask', { method: 'POST', body: fd });
                const result = await res.json();
                if (result.success) { showToast(result.message, 'success'); setTimeout(() => location.reload(), 800); }
                else { errText.innerText = result.message; errEl.classList.remove('hidden'); }
            } catch (err) {
                errText.innerText = 'Network error.';
                errEl.classList.remove('hidden');
            } finally {
                btn.disabled = false;
                btn.innerText = 'Create Task';
            }
        }

        // ============================================
        // UTIL
        // ============================================
        function escapeHtml(s) {
            if (!s) return '';
            return s.replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }
    </script>
}