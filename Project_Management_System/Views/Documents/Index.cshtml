@model Project_Management_System.ViewModels.DocumentsIndexViewModel
@{
    ViewData["Title"] = "Documents";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var canUpload = Model.CanUpload;

    string ProjectGradient(string color) => color switch
    {
        "emerald" => "from-emerald-500 to-teal-500",
        "amber" => "from-amber-500 to-orange-500",
        "blue" => "from-blue-500 to-indigo-500",
        "purple" => "from-purple-500 to-pink-500",
        "red" => "from-red-500 to-rose-500",
        _ => "from-gray-500 to-gray-600"
    };

    // Returns (bg, text, icon, label) per document extension
    (string bg, string text, string label) ExtInfo(string ext) => ext switch
    {
        "PDF" => ("bg-red-50", "text-red-600", "PDF"),
        "DOC" => ("bg-blue-50", "text-blue-600", "DOC"),
        "DOCX" => ("bg-blue-50", "text-blue-600", "DOCX"),
        _ => ("bg-gray-50", "text-gray-600", ext)
    };
}

<div class="bg-gray-100 min-h-screen p-6">

    @Html.AntiForgeryToken()

    <!-- Page Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4">
        <div>
            <h1 class="text-4xl font-bold text-gray-900 flex items-center gap-3">
                <svg class="w-10 h-10 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                </svg>
                Documents
            </h1>
            <p class="text-lg text-gray-600 mt-2 font-medium">
                @(canUpload
                                ? "Upload PDF and Word documents for your projects."
                                : "Preview and download project files.")
            </p>
        </div>
        @if (canUpload)
        {
            <button onclick="openUploadModal()" class="px-6 py-3 bg-brand text-sidebar text-base font-bold rounded-lg hover:bg-yellow-400 transition-colors shadow-glow flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                Upload Document
            </button>
        }
    </div>

    <!-- KPI Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">

        <div class="bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl shadow-lg p-5 text-white relative overflow-hidden">
            <div class="absolute -right-4 -top-4 w-24 h-24 bg-white/10 rounded-full"></div>
            <div class="relative flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold text-blue-100 uppercase tracking-wide">Total Documents</p>
                    <h3 class="text-4xl font-black mt-2">@Model.TotalDocuments</h3>
                    <p class="text-xs text-blue-100 font-medium mt-1">Across @Model.ProjectCount project@(Model.ProjectCount != 1 ? "s" : "")</p>
                </div>
                <svg class="w-12 h-12 text-blue-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            </div>
        </div>

        <div class="bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl shadow-lg p-5 text-white relative overflow-hidden">
            <div class="absolute -right-4 -top-4 w-24 h-24 bg-white/10 rounded-full"></div>
            <div class="relative flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold text-purple-100 uppercase tracking-wide">Storage Used</p>
                    <h3 class="text-4xl font-black mt-2">@Model.FormattedStorage</h3>
                    <p class="text-xs text-purple-100 font-medium mt-1">total</p>
                </div>
                <svg class="w-12 h-12 text-purple-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path></svg>
            </div>
        </div>

        <div class="bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-xl shadow-lg p-5 text-white relative overflow-hidden">
            <div class="absolute -right-4 -top-4 w-24 h-24 bg-white/10 rounded-full"></div>
            <div class="relative flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold text-emerald-100 uppercase tracking-wide">This Week</p>
                    <h3 class="text-4xl font-black mt-2">@Model.UploadsThisWeek</h3>
                    <p class="text-xs text-emerald-100 font-medium mt-1">New uploads</p>
                </div>
                <svg class="w-12 h-12 text-emerald-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
        </div>

        <div class="bg-gradient-to-br from-amber-500 to-orange-500 rounded-xl shadow-lg p-5 text-white relative overflow-hidden">
            <div class="absolute -right-4 -top-4 w-24 h-24 bg-white/10 rounded-full"></div>
            <div class="relative flex items-center justify-between">
                <div>
                    <p class="text-xs font-bold text-amber-100 uppercase tracking-wide">Projects</p>
                    <h3 class="text-4xl font-black mt-2">@Model.ProjectCount</h3>
                    <p class="text-xs text-amber-100 font-medium mt-1">With documents</p>
                </div>
                <svg class="w-12 h-12 text-amber-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
            </div>
        </div>
    </div>

    <!-- Search + Filter -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 mb-6">
        <div class="flex flex-col md:flex-row md:items-center gap-4">
            <div class="relative flex-1">
                <svg class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                <input type="text" id="docSearch" onkeyup="filterDocuments()" placeholder="Search documents by name..."
                       class="w-full bg-gray-50 border border-gray-200 text-gray-900 text-base rounded-lg pl-10 pr-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand/60">
            </div>

            @if (Model.AvailableProjects.Count > 0)
            {
                <div class="relative" id="projectDropdownWrapper">
                    <button onclick="toggleProjectDropdown(event)" id="projectDropdownBtn"
                            class="flex items-center gap-3 px-5 py-3 bg-white border-2 border-gray-200 rounded-lg hover:border-brand/60 hover:bg-gray-50 transition-all min-w-[240px] justify-between">
                        <div class="flex items-center gap-3">
                            <div id="dropdownSelectedIcon" class="w-9 h-9 rounded-lg bg-gradient-to-br from-gray-400 to-gray-500 flex items-center justify-center text-white font-black text-xs shadow">
                                ALL
                            </div>
                            <div class="text-left">
                                <p class="text-xs font-bold text-gray-500 uppercase tracking-wide">Project</p>
                                <p id="dropdownSelectedName" class="text-sm font-bold text-gray-900">All Projects</p>
                            </div>
                        </div>
                        <svg id="dropdownChevron" class="w-5 h-5 text-gray-500 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </button>

                    <div id="projectDropdownPanel" style="display:none;"
                         class="absolute right-0 top-full mt-2 w-80 bg-white rounded-xl shadow-2xl border border-gray-100 z-40 overflow-hidden">
                        <div class="px-4 py-3 bg-gray-50 border-b border-gray-100">
                            <p class="text-xs font-black text-gray-500 uppercase tracking-wider">Available Projects</p>
                        </div>
                        <div class="max-h-80 overflow-y-auto py-1">
                            <button onclick="selectProject('all', 'All Projects', 'ALL', 'from-gray-400 to-gray-500', this)"
                                    class="project-option w-full flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition-colors text-left">
                                <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-gray-400 to-gray-500 flex items-center justify-center text-white font-black text-xs shadow shrink-0">ALL</div>
                                <div class="flex-1">
                                    <p class="text-sm font-bold text-gray-900">All Projects</p>
                                    <p class="text-xs text-gray-500 font-medium">Show documents from all projects</p>
                                </div>
                                <svg class="w-5 h-5 text-brand hidden check-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </button>

                            @foreach (var p in Model.AvailableProjects)
                            {
                                var grad = ProjectGradient(p.Color);
                                <button onclick="selectProject('@p.Id', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(p.Name))', '@p.Initials', '@grad', this)"
                                        class="project-option w-full flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition-colors text-left">
                                    <div class="w-10 h-10 rounded-lg bg-gradient-to-br @grad flex items-center justify-center text-white font-black text-xs shadow shrink-0">@p.Initials</div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm font-bold text-gray-900 truncate">@p.Name</p>
                                    </div>
                                    <svg class="w-5 h-5 text-brand hidden check-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                </button>
                            }
                        </div>
                        <div class="px-4 py-3 bg-gray-50 border-t border-gray-100">
                            <p class="text-xs text-gray-500 font-semibold">@Model.AvailableProjects.Count project@(Model.AvailableProjects.Count != 1 ? "s" : "") total</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Documents grouped by project -->
    @if (Model.Projects.Count == 0)
    {
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-16 text-center">
            <h3 class="text-2xl font-bold text-gray-900 mb-2">No projects yet</h3>
            <p class="text-gray-500">Documents will appear here once projects have files.</p>
        </div>
    }

    @foreach (var proj in Model.Projects)
    {
        var grad = ProjectGradient(proj.Color);

        <div class="project-section mb-6" data-project="@proj.ProjectId">
            <div class="flex items-center gap-3 mb-4">
                <div class="w-11 h-11 rounded-lg bg-gradient-to-br @grad flex items-center justify-center text-white font-black text-sm shadow-lg">@proj.Initials</div>
                <div>
                    <h2 class="text-2xl font-bold text-gray-900">@proj.ProjectName</h2>
                    <p class="text-sm text-gray-500 font-medium">@(proj.Client ?? "—") • @proj.Documents.Count document@(proj.Documents.Count != 1 ? "s" : "")</p>
                </div>
            </div>

            @if (proj.Documents.Count == 0)
            {
                <div class="bg-gray-50 rounded-xl border-2 border-dashed border-gray-200 p-8 text-center">
                    <p class="text-sm text-gray-400 font-medium">No documents in this project yet.</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    @foreach (var doc in proj.Documents)
                    {
                        var info = ExtInfo(doc.Extension);
                        <div class="doc-card bg-white rounded-xl shadow-md border border-gray-100 p-5 hover:shadow-xl transition-all"
                             data-name="@doc.Title"
                             data-project-id="@proj.ProjectId"
                             data-doc-id="@doc.Id">
                            <div class="flex items-start justify-between mb-3">
                                <div class="w-14 h-14 rounded-xl @info.bg flex items-center justify-center @info.text shrink-0">
                                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                                    </svg>
                                </div>
                                <span class="px-2.5 py-1 text-xs font-black @info.bg @info.text rounded-full">@info.label</span>
                            </div>
                            <h4 class="text-base font-bold text-gray-900 mb-1 truncate" title="@doc.Title">@doc.Title</h4>
                            <p class="text-xs text-gray-500 font-medium mb-1">@doc.FormattedSize • @doc.UploadedAt.ToString("MMM dd, yyyy")</p>
                            <p class="text-xs text-gray-400 font-medium mb-4">By @doc.UploadedByName</p>

                            <div class="flex items-center gap-2 pt-3 border-t border-gray-100">
                                <button onclick="previewDocument('@doc.Id', '@doc.Extension', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(doc.Title))')"
                                        class="flex-1 py-2 bg-blue-50 text-blue-700 text-xs font-bold rounded-md hover:bg-blue-100 flex items-center justify-center gap-1.5 transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                    Preview
                                </button>
                                <a href="@doc.DownloadUrl" download
                                   class="flex-1 py-2 bg-emerald-50 text-emerald-700 text-xs font-bold rounded-md hover:bg-emerald-100 flex items-center justify-center gap-1.5 transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                                    Download
                                </a>
                                @if (canUpload)
                                {
                                    <button onclick="deleteDocument('@doc.Id', '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(doc.Title))')"
                                            class="py-2 px-3 bg-red-50 text-red-600 text-xs font-bold rounded-md hover:bg-red-100 transition-colors" title="Delete">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<!-- ============================================= -->
<!-- PREVIEW MODAL                                  -->
<!-- ============================================= -->
<div id="previewModal" style="display:none;" class="fixed inset-0 z-50 bg-gray-900/80 backdrop-blur-sm items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-6xl overflow-hidden flex flex-col" style="height: 90vh;">

        <!-- Header -->
        <div class="bg-gradient-to-r from-gray-800 to-gray-900 px-6 py-4 flex justify-between items-center shrink-0">
            <div class="flex items-center gap-3 min-w-0">
                <div class="w-10 h-10 rounded-lg bg-white/20 flex items-center justify-center text-white shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                    </svg>
                </div>
                <div class="min-w-0">
                    <h3 class="text-lg font-bold text-white truncate" id="previewTitle">Document Preview</h3>
                    <p class="text-xs text-gray-300 font-medium" id="previewSubtitle">Loading…</p>
                </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
                <a id="previewDownloadBtn" href="#" download
                   class="px-3 py-2 bg-white/20 hover:bg-white/30 text-white text-sm font-bold rounded-lg flex items-center gap-1.5 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                    Download
                </a>
                <button onclick="closePreviewModal()" class="text-white/80 hover:text-white p-2 rounded-full hover:bg-white/20 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
        </div>

        <!-- Body -->
        <div class="flex-1 overflow-auto bg-gray-100 relative" id="previewBody">
            <!-- filled dynamically by JS -->
        </div>
    </div>
</div>

<!-- Upload Modal -->
@if (canUpload)
{
    <div id="uploadModal" style="display:none;" class="fixed inset-0 z-50 bg-gray-900/60 backdrop-blur-sm items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden max-h-[90vh] flex flex-col">
            <div class="bg-gradient-to-r from-blue-500 to-indigo-600 px-6 py-5 flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center text-white">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold text-white">Upload Document</h3>
                </div>
                <button onclick="closeModal('uploadModal')" class="text-white/80 hover:text-white p-1 rounded-full hover:bg-white/20">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <form id="uploadForm" class="p-6 space-y-5 overflow-y-auto">
                <input type="hidden" id="uploadProjectId" />

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Project *</label>
                    <select id="uploadProject" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand/60 outline-none">
                        <option value="">Select project...</option>
                        @foreach (var p in Model.AvailableProjects)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">File (PDF or Word, max 50 MB) *</label>
                    <div class="border-2 border-dashed border-gray-300 rounded-xl p-6 text-center hover:border-brand transition-colors cursor-pointer" onclick="document.getElementById('uploadFile').click();">
                        <div class="w-14 h-14 mx-auto mb-3 rounded-full bg-blue-50 flex items-center justify-center text-blue-600">
                            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
                        </div>
                        <p class="text-base font-bold text-gray-900 mb-1" id="uploadFileLabel">Click to browse</p>
                        <p class="text-sm text-gray-500">PDF, DOC, DOCX</p>
                    </div>
                    <input type="file" id="uploadFile" accept=".pdf,.doc,.docx" class="hidden" onchange="updateUploadFileLabel(this)">
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Title</label>
                    <input type="text" id="uploadTitle" placeholder="Leave blank to use the file name"
                           class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand/60 outline-none">
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Document Type</label>
                    <select id="uploadType" class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand/60 outline-none">
                        <option value="Contract">Contract</option>
                        <option value="Drawing">Drawing</option>
                        <option value="Report" selected>Report</option>
                        <option value="Invoice">Invoice</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-1.5">Notes (Optional)</label>
                    <textarea id="uploadNotes" rows="2" placeholder="Any details about this document..."
                          class="w-full border border-gray-300 rounded-lg px-4 py-2.5 focus:ring-2 focus:ring-brand/60 outline-none resize-none"></textarea>
                </div>

                <div id="uploadError" class="hidden p-3 bg-red-50 border border-red-200 rounded-lg">
                    <p class="text-sm font-semibold text-red-700" id="uploadErrorText"></p>
                </div>
            </form>

            <div class="bg-gray-50 px-6 py-4 flex justify-end gap-3 border-t border-gray-100">
                <button type="button" onclick="closeModal('uploadModal')" class="px-5 py-2.5 border border-gray-300 rounded-lg font-semibold text-gray-700">Cancel</button>
                <button type="button" id="btnUpload" onclick="submitUpload()" class="px-6 py-2.5 bg-brand text-sidebar rounded-lg font-bold hover:bg-yellow-400">Upload</button>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/docx-preview@0.3.1/dist/docx-preview.min.js"></script>
    <script>
        let currentProjectFilter = 'all';

        function getToken() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        function openModal(id) { const el = document.getElementById(id); if (el) el.style.display = 'flex'; }
        function closeModal(id) { const el = document.getElementById(id); if (el) el.style.display = 'none'; }

        function showToast(message, type = 'success') {
            const bg = type === 'success' ? 'bg-emerald-500' : 'bg-red-500';
            const t = document.createElement('div');
            t.className = `fixed top-6 right-6 z-[60] ${bg} text-white px-6 py-4 rounded-xl shadow-2xl font-semibold text-base`;
            t.innerText = message;
            document.body.appendChild(t);
            setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 300); }, 3500);
        }

        // ============ UPLOAD MODAL ============
        function openUploadModal() {
            document.getElementById('uploadProject').value = '';
            document.getElementById('uploadFile').value = '';
            document.getElementById('uploadTitle').value = '';
            document.getElementById('uploadNotes').value = '';
            document.getElementById('uploadType').value = 'Report';
            document.getElementById('uploadFileLabel').innerText = 'Click to browse';
            document.getElementById('uploadError').classList.add('hidden');
            openModal('uploadModal');
        }

        function updateUploadFileLabel(input) {
            const label = document.getElementById('uploadFileLabel');
            label.innerText = input.files.length > 0 ? input.files[0].name : 'Click to browse';
        }

        async function submitUpload() {
            const errEl = document.getElementById('uploadError');
            const errTxt = document.getElementById('uploadErrorText');
            errEl.classList.add('hidden');

            const projectId = document.getElementById('uploadProject').value;
            const file = document.getElementById('uploadFile').files[0];
            const title = document.getElementById('uploadTitle').value.trim();
            const type = document.getElementById('uploadType').value;
            const notes = document.getElementById('uploadNotes').value.trim();

            if (!projectId) { errTxt.innerText = 'Select a project.'; errEl.classList.remove('hidden'); return; }
            if (!file) { errTxt.innerText = 'Select a file.'; errEl.classList.remove('hidden'); return; }

            const fd = new FormData();
            fd.append('projectId', projectId);
            fd.append('title', title);
            fd.append('documentType', type);
            fd.append('notes', notes);
            fd.append('file', file);
            fd.append('__RequestVerificationToken', getToken());

            const btn = document.getElementById('btnUpload');
            btn.disabled = true; btn.innerText = 'Uploading...';

            try {
                const res = await fetch('/Documents/Upload', { method: 'POST', body: fd });
                const r = await res.json();
                if (r.success) {
                    closeModal('uploadModal');
                    showToast(r.message);
                    setTimeout(() => location.reload(), 800);
                } else {
                    errTxt.innerText = r.message;
                    errEl.classList.remove('hidden');
                }
            } catch (e) {
                errTxt.innerText = 'Upload failed.';
                errEl.classList.remove('hidden');
            } finally {
                btn.disabled = false; btn.innerText = 'Upload';
            }
        }

        // ============ DELETE ============
        async function deleteDocument(id, title) {
            if (!confirm(`Delete "${title}"? This cannot be undone.`)) return;

            const fd = new FormData();
            fd.append('__RequestVerificationToken', getToken());

            const res = await fetch(`/Documents/Delete/${id}`, { method: 'POST', body: fd });
            const r = await res.json();
            if (r.success) {
                showToast(r.message);
                const card = document.querySelector(`.doc-card[data-doc-id="${id}"]`);
                if (card) card.remove();
            } else {
                showToast(r.message, 'error');
            }
        }

        // ============ PROJECT DROPDOWN ============
        function toggleProjectDropdown(event) {
            event.stopPropagation();
            const panel = document.getElementById('projectDropdownPanel');
            const chevron = document.getElementById('dropdownChevron');
            if (panel.style.display === 'none') {
                panel.style.display = 'block';
                chevron.style.transform = 'rotate(180deg)';
            } else {
                panel.style.display = 'none';
                chevron.style.transform = 'rotate(0deg)';
            }
        }

        function closeProjectDropdown() {
            const panel = document.getElementById('projectDropdownPanel');
            const chevron = document.getElementById('dropdownChevron');
            if (panel) panel.style.display = 'none';
            if (chevron) chevron.style.transform = 'rotate(0deg)';
        }

        function selectProject(projectKey, projectName, initials, gradient, btnEl) {
            currentProjectFilter = projectKey;

            document.getElementById('dropdownSelectedName').innerText = projectName;
            const iconEl = document.getElementById('dropdownSelectedIcon');
            iconEl.innerText = initials;
            iconEl.className = `w-9 h-9 rounded-lg bg-gradient-to-br ${gradient} flex items-center justify-center text-white font-black text-xs shadow`;

            document.querySelectorAll('.project-option .check-icon').forEach(ic => ic.classList.add('hidden'));
            const check = btnEl.querySelector('.check-icon');
            if (check) check.classList.remove('hidden');

            document.querySelectorAll('.project-section').forEach(section => {
                section.style.display = (projectKey === 'all' || section.dataset.project === projectKey) ? '' : 'none';
            });

            closeProjectDropdown();
        }

        document.addEventListener('click', function (e) {
            const wrapper = document.getElementById('projectDropdownWrapper');
            if (wrapper && !wrapper.contains(e.target)) closeProjectDropdown();
        });

        // ============ SEARCH ============
        function filterDocuments() {
            const q = document.getElementById('docSearch').value.toLowerCase();

            document.querySelectorAll('.doc-card').forEach(card => {
                const name = (card.dataset.name || '').toLowerCase();
                card.style.display = name.includes(q) ? '' : 'none';
            });

            if (q === '') {
                document.querySelectorAll('.project-section').forEach(section => {
                    section.style.display = (currentProjectFilter === 'all' || section.dataset.project === currentProjectFilter) ? '' : 'none';
                });
            } else {
                document.querySelectorAll('.project-section').forEach(section => {
                    const visible = Array.from(section.querySelectorAll('.doc-card')).some(c => c.style.display !== 'none');
                    section.style.display = visible ? '' : 'none';
                });
            }
        }

                // ============================================
        // DOCUMENT PREVIEW
        // ============================================
        let activePreviewUrl = null;

        async function previewDocument(docId, extension, title) {
            const modal      = document.getElementById('previewModal');
            const body       = document.getElementById('previewBody');
            const titleEl    = document.getElementById('previewTitle');
            const subtitle   = document.getElementById('previewSubtitle');
            const dlBtn      = document.getElementById('previewDownloadBtn');

            const ext = (extension || '').toUpperCase();

            titleEl.innerText  = title || 'Document Preview';
            subtitle.innerText = ext ? `${ext} • Loading…` : 'Loading…';
            dlBtn.href         = `/Documents/Download/${docId}`;

            // Loading spinner
            body.innerHTML = `
                <div class="flex items-center justify-center h-full">
                    <div class="text-center">
                        <div class="w-12 h-12 border-4 border-blue-500 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
                        <p class="text-gray-500 font-medium">Loading preview…</p>
                    </div>
                </div>`;

            modal.style.display = 'flex';

            // ── PDF → render inside an iframe ──
            if (ext === 'PDF') {
                // Free the previous iframe URL if any
                if (activePreviewUrl) { URL.revokeObjectURL(activePreviewUrl); activePreviewUrl = null; }

                body.innerHTML = `<iframe src="/Documents/Preview/${docId}#toolbar=1&navpanes=0"
                                          style="width:100%;height:100%;border:0;display:block;"></iframe>`;
                subtitle.innerText = 'PDF • Inline viewer';
                return;
            }

            // ── DOCX → render with docx-preview ──
            if (ext === 'DOCX') {
                try {
                    const res  = await fetch(`/Documents/Preview/${docId}`);
                    if (!res.ok) throw new Error('Fetch failed');
                    const blob = await res.blob();

                    body.innerHTML = `
                        <div class="bg-gray-200 py-6 px-4 flex justify-center min-h-full">
                            <div id="docxContainer" class="bg-white shadow-2xl" style="max-width: 850px; width: 100%;"></div>
                        </div>`;

                    const container = document.getElementById('docxContainer');

                    // Check the library loaded
                    if (typeof docx === 'undefined' || !docx.renderAsync) {
                        throw new Error('docx-preview library not loaded');
                    }

                    await docx.renderAsync(blob, container, null, {
                        className: 'docx',
                        inWrapper: true,
                        ignoreWidth: false,
                        ignoreHeight: false,
                        renderHeaders: true,
                        renderFooters: true,
                        breakPages: true
                    });

                    subtitle.innerText = 'DOCX • Rendered preview';
                } catch (err) {
                    console.error(err);
                    showPreviewFallback(body, 'We couldn\'t render this Word file. Please download to view it.');
                    subtitle.innerText = 'Preview not available';
                }
                return;
            }

            // ── DOC (legacy) or unknown → not renderable in browser ──
            showPreviewFallback(body, 'Preview isn\'t available for this file type. Please download to view it.');
            subtitle.innerText = 'Preview not available';
        }

        function showPreviewFallback(container, message) {
            container.innerHTML = `
                <div class="flex items-center justify-center h-full p-8">
                    <div class="text-center max-w-md">
                        <div class="w-20 h-20 mx-auto mb-5 rounded-full bg-amber-100 flex items-center justify-center">
                            <svg class="w-10 h-10 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">Preview not available</h3>
                        <p class="text-gray-500 text-sm mb-6">${message}</p>
                        <a href="${document.getElementById('previewDownloadBtn').href}" download
                           class="inline-flex items-center gap-2 px-5 py-2.5 bg-brand text-sidebar font-bold rounded-lg hover:bg-yellow-400">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                            Download file
                        </a>
                    </div>
                </div>`;
        }

        function closePreviewModal() {
            const modal = document.getElementById('previewModal');
            const body  = document.getElementById('previewBody');

            // Clear content so the iframe stops loading / the docx renderer frees memory
            body.innerHTML = '';

            // Revoke any blob URL we created
            if (activePreviewUrl) { URL.revokeObjectURL(activePreviewUrl); activePreviewUrl = null; }

            modal.style.display = 'none';
        }

        // Close on ESC
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closePreviewModal();
        });
    </script>
}